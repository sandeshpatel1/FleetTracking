        <div class="tbl-empty-state" id="tbl-filter-empty" style="display:none">
            <span class="tes-icon">🔎</span>
            No devices match the current filter.
            <br>
            <button type="button" onclick="setStatusFilter('all')">Show all devices</button>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // ── Safety net ────────────────────────────────────────────────
            // If Maps init throws for any reason, or the Maps script/API key
            // never calls back at all, show a visible error instead of
            // leaving the spinner running forever with no clue why.
            function showMapError(msg) {
                const loading = document.getElementById('dash-map-loading');
                if (!loading) return;
                loading.classList.remove('gone');
                loading.innerHTML = `<div style="color:#dc2626;font-family:monospace;font-size:12px;text-align:center;padding:20px;max-width:320px;line-height:1.6">
                                                    ⚠ ${msg}<br><small style="color:#999">Check the browser console (F12) for details.</small>
                                                </div>`;
            }
            const mapWatchdog = setTimeout(() => showMapError('Map is taking too long to load.'), 15000);

            try {

                const GEO_FENCES = @Html.Raw(geoJson);
                const PARKING = @Html.Raw(parkJson);
                let DEVICES = @Html.Raw(devJson);

                // ══════════════════════════════════════════════════════════════
                // Small helpers
                // ══════════════════════════════════════════════════════════════
                function imgPath(name) {
                    if (!name) return '';
                    return `/assest/${encodeURIComponent(name)}.jpeg`;
                }

                const DEVICE_COLORS = ['#2563eb', '#dc2626', '#16a34a', '#9333ea', '#ea580c', '#0891b2', '#db2777', '#65a30d', '#0d9488', '#7c3aed', '#f59e0b', '#4f46e5'];
                function deviceColor(imei) {
                    let h = 0;
                    for (let i = 0; i < imei.length; i++) h = (h * 31 + imei.charCodeAt(i)) >>> 0;
                    return DEVICE_COLORS[h % DEVICE_COLORS.length];
                }

                function haversineKm(lat1, lng1, lat2, lng2) {
                    const R = 6371, toRad = x => x * Math.PI / 180;
                    const dLat = toRad(lat2 - lat1), dLng = toRad(lng2 - lng1);
                    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
                    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                }

                function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

                // ══════════════════════════════════════════════════════════════
                // Geofence hover tooltip — shows the zone/parking-location name
                // AND the current vehicle count only while the cursor is over
                // that zone's boundary area (the filled polygon) or its small
                // marker dot. The name is NEVER rendered as a permanent label
                // on the map itself.
                // ══════════════════════════════════════════════════════════════
                const geoTooltipEl = document.getElementById('geo-name-tooltip');
                function showGeoTooltip(name, count, domEvent) {
                    if (!geoTooltipEl) return;
                    const countText = (count !== null && count !== undefined) ? ` • ${count} 🚛` : '';
                    geoTooltipEl.textContent = (name || 'Zone') + countText;
                    geoTooltipEl.classList.add('show');
                    positionGeoTooltip(domEvent);
                }
                function positionGeoTooltip(domEvent) {
                    if (!geoTooltipEl || !domEvent) return;
                    const mapEl = document.getElementById('dash-map');
                    if (!mapEl) return;
                    const rect = mapEl.getBoundingClientRect();
                    const cx = domEvent.clientX, cy = domEvent.clientY;
                    if (cx == null || cy == null) return;
                    geoTooltipEl.style.left = (cx - rect.left + 14) + 'px';
                    geoTooltipEl.style.top = (cy - rect.top - 12) + 'px';
                }
                function hideGeoTooltip() {
                    if (geoTooltipEl) geoTooltipEl.classList.remove('show');
                }

                // ══════════════════════════════════════════════════════════════
                // FULL BOUNDARY (every point included) for a zone's recorded
                // parking coordinates (gps_parking_location_coordinates rows
                // only). Three earlier approaches were tried and dropped:
                //   • Nearest-neighbour ordering could zig-zag back across itself.
                //   • Sorting by angle around the centroid usually avoids that,
                //     but for elongated / narrow / zigzag point layouts an edge
                //     could still cut back through the middle of the shape.
                //   • A pure convex hull never self-intersects, but silently
                //     drops any point that sits inside the hull rather than on
                //     the true outer edge — not acceptable when every recorded
                //     stop should be a corner of the boundary.
                //
                // This uses the "cheapest insertion" approach: start from the
                // convex hull (guaranteed simple, no crossings) as the base
                // loop, then repeatedly take whichever remaining point can be
                // inserted into whichever boundary edge for the SMALLEST
                // increase in total perimeter, and splice it in there — one
                // point at a time, recomputing after each insertion — until
                // every point is part of the loop. For the kind of point
                // layout this app deals with (a handful of real-world
                // coordinates recorded around a single physical site) this
                // reliably traces the true perimeter through every point
                // without the boundary cutting back through its own interior.
                // It is not a hard mathematical guarantee against
                // self-crossing the way a pure hull is — an artificially
                // adversarial scatter of points could in theory still pinch —
                // but it is the standard practical technique for exactly this
                // "draw a simple boundary through every point" problem.
                //
                // Distances use haversineKm (already defined above) so the
                // insertion cost reflects real-world metres, not raw
                // lat/lng differences. The zone's own gps_geo_fencing_location
                // point (its label/centre marker) is never part of this — it
                // is only ever passed in separately as a plain marker.
                // ══════════════════════════════════════════════════════════════
                function computeConvexHull(points) {
                    const pts = points.slice().sort((a, b) => a.Longitude - b.Longitude || a.Latitude - b.Latitude);
                    const cross = (o, a, b) =>
                        (a.Longitude - o.Longitude) * (b.Latitude - o.Latitude) -
                        (a.Latitude - o.Latitude) * (b.Longitude - o.Longitude);

                    const lower = [];
                    for (const p of pts) {
                        while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop();
                        lower.push(p);
                    }
                    const upper = [];
                    for (let i = pts.length - 1; i >= 0; i--) {
                        const p = pts[i];
                        while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop();
                        upper.push(p);
                    }
                    lower.pop();
                    upper.pop();
                    const hull = lower.concat(upper);
                    return hull.length >= 3 ? hull : pts;
                }

                function fullBoundaryOrder(points) {
                    if (points.length < 3) return points.slice();

                    // Dedupe identical coordinates — duplicate stops would
                    // otherwise create zero-length edges that add nothing but
                    // insertion-cost noise.
                    const seen = new Set();
                    const uniq = [];
                    points.forEach(p => {
                        const key = p.Longitude + ',' + p.Latitude;
                        if (!seen.has(key)) { seen.add(key); uniq.push(p); }
                    });
                    if (uniq.length < 3) return uniq;

                    const dist = (a, b) => haversineKm(a.Latitude, a.Longitude, b.Latitude, b.Longitude);

                    // Base loop = convex hull (every edge here is guaranteed simple).
                    let loop = computeConvexHull(uniq);
                    const inLoop = new Set(loop);
                    let remaining = uniq.filter(p => !inLoop.has(p));

                    // Cheapest insertion: repeatedly insert whichever remaining
                    // point, into whichever boundary edge, adds the least total
                    // perimeter — then remove it from the remaining pool and
                    // repeat until every point has been placed.
                    while (remaining.length) {
                        let bestPtIdx = -1, bestEdgeIdx = -1, bestCost = Infinity;
                        for (let ri = 0; ri < remaining.length; ri++) {
                            const p = remaining[ri];
                            for (let ei = 0; ei < loop.length; ei++) {
                                const a = loop[ei], b = loop[(ei + 1) % loop.length];
                                const cost = dist(a, p) + dist(p, b) - dist(a, b);
                                if (cost < bestCost) { bestCost = cost; bestPtIdx = ri; bestEdgeIdx = ei; }
                            }
                        }
                        const point = remaining[bestPtIdx];
                        loop.splice(bestEdgeIdx + 1, 0, point);
                        remaining.splice(bestPtIdx, 1);
                    }
                    return loop;
                }

                function loopDistanceKm(ordered) {
                    if (ordered.length < 2) return 0;
                    let d = 0;
                    for (let i = 0; i < ordered.length; i++) {
                        const a = ordered[i], b = ordered[(i + 1) % ordered.length]; // wraps → closes the loop
                        d += haversineKm(a.Latitude, a.Longitude, b.Latitude, b.Longitude);
                    }
                    return d;
                }

                // ══════════════════════════════════════════════════════════════
                // Standard ray-casting point-in-polygon test. lat/lng are used
                // directly as y/x — perfectly adequate at the scale of a single
                // parking site. This is what actually decides "is this device
                // inside the SHAPE YOU SEE DRAWN", instead of the old approach
                // of measuring straight-line distance from the zone's centre
                // point. That old approach is why a device could sit well
                // outside the visible tinted boundary and still get counted as
                // "inside" (or the reverse) — a circle drawn around a single
                // centre point rarely matches an irregular real-world polygon,
                // and the mismatch was invisible at low zoom but obvious once
                // you zoomed in on the actual shape.
                // ══════════════════════════════════════════════════════════════
                function pointInPolygon(lat, lng, polyPts) {
                    let inside = false;
                    for (let i = 0, j = polyPts.length - 1; i < polyPts.length; j = i++) {
                        const yi = polyPts[i].Latitude, xi = polyPts[i].Longitude;
                        const yj = polyPts[j].Latitude, xj = polyPts[j].Longitude;
                        const intersects = ((yi > lat) !== (yj > lat)) &&
                            (lng < (xj - xi) * (lat - yi) / (yj - yi) + xi);
                        if (intersects) inside = !inside;
                    }
                    return inside;
                }

                // ══════════════════════════════════════════════════════════════
                // Each zone's real boundary, computed ONCE up front (not
                // recomputed per refresh) so both the drawn polygon and the
                // containment test used for device grouping always agree with
                // each other. Zones with fewer than 2 recorded parking points
                // have no polygon possible — those fall back to a plain circle
                // of the zone's own registered radius (floor 30m, same floor
                // the server already uses), which also gives every zone a
                // visible boundary instead of leaving a lone, unenclosed dot.
                // ══════════════════════════════════════════════════════════════
                const pkByLoc = {};
                PARKING.forEach(p => {
                    const k = p.ParkingLocationId;
                    if (!pkByLoc[k]) pkByLoc[k] = [];
                    pkByLoc[k].push(p);
                });
                const zoneBoundaryPts = {};   // geoId -> ordered polygon points, or null
                GEO_FENCES.forEach(g => {
                    const pts = pkByLoc[g.Id] || [];
                    zoneBoundaryPts[g.Id] = pts.length >= 2 ? fullBoundaryOrder(pts) : null;
                });

                // ══════════════════════════════════════════════════════════════
                // Devices-per-geofence. Each device is assigned to AT MOST ONE
                // zone — the zone whose real boundary (polygon, or circle when
                // there's no polygon) it is genuinely inside, preferring the
                // nearest centre if it somehow matches more than one overlapping
                // zone. A device that isn't inside any zone's boundary is
                // returned separately as "unassigned" — it is STILL drawn as a
                // truck marker on the map (just not tied to any zone's badge
                // count or the zone-filter visibility rules), it simply never
                // gets attributed to a specific geofence.
                // ══════════════════════════════════════════════════════════════
                function computeDevicesByGeo(devices) {
                    const byGeo = {};
                    GEO_FENCES.forEach(g => { byGeo[g.Id] = []; });
                    const unassigned = [];

                    devices.forEach(d => {
                        if (!d.Latitude || !d.Longitude) return;

                        let bestId = null, bestDistKm = Infinity;
                        GEO_FENCES.forEach(g => {
                            if (!g.Latitude || !g.Longitude) return;

                            const boundary = zoneBoundaryPts[g.Id];
                            let contained;
                            if (boundary) {
                                contained = pointInPolygon(d.Latitude, d.Longitude, boundary);
                            } else {
                                const radiusKm = Math.max(g.RadiusMeters || 0, 30) / 1000;
                                contained = haversineKm(g.Latitude, g.Longitude, d.Latitude, d.Longitude) <= radiusKm;
                            }
                            if (!contained) return;

                            const distKm = haversineKm(g.Latitude, g.Longitude, d.Latitude, d.Longitude);
                            if (distKm < bestDistKm) { bestDistKm = distKm; bestId = g.Id; }
                        });

                        if (bestId !== null) byGeo[bestId].push(d);
                        else unassigned.push(d);
                    });

                    return { byGeo, unassigned };
                }
                const initialGrouping = computeDevicesByGeo(DEVICES);
                let devicesByGeo = initialGrouping.byGeo;
                let unassignedDevices = initialGrouping.unassigned;

                // Declared up-front (before anything that reads them) so that
                // the immediate paintSidebarBadges() call below never hits a
                // "used before initialization" error — a const/let reference
                // before its own declaration line throws in JS even within the
                // same scope, and if that throw happens at the top level of
                // this IIFE it aborts the whole script silently, which is what
                // was leaving the map stuck on "LOADING MAP…" forever: the
                // script never reached the line that registers initDashMap as
                // the Google Maps callback.
                let gmap, sharedInfoWin, AdvancedMarkerElement;
                const geoShapes = {};      // geoId -> { pts, geo, clr, center, devices, photo, zoneBounds, pathLengthM, zoneBadgeEl, boundary, zoneLabelMarker, parkingMarkers }
                const deviceMarkers = {};  // imei  -> { marker, iconEl, labelEl, geoId }

                // null = every zone's boundary/marker/parking-dots are shown.
                // a geoId = only that zone's boundary/marker/parking-dots are shown.
                // Truck markers are deliberately NOT affected by this filter — they
                // always stay visible everywhere, regardless of the selected zone,
                // and that includes unassigned trucks (no zone at all).
                let activeGeoFilter = null;

                // Remembers the most recently clicked zone so the "Show All" button
                // can toggle back to it instead of just always resetting to "all".
                let lastSelectedGeoId = null;

                function paintSidebarBadges() {
                    Object.keys(devicesByGeo).forEach(gid => {
                        const badge = document.getElementById('devcnt-' + gid);
                        if (!badge) return;
                        const n = devicesByGeo[gid].length;
                        badge.style.display = 'inline-flex';
                        badge.textContent = n + ' 🚛';
                        badge.style.background = n > 0 ? 'rgba(37,99,235,.12)' : 'rgba(0,0,0,.06)';
                        badge.style.color = n > 0 ? '#2563eb' : '#999';
                        const s = geoShapes[gid];
                        if (s && s.zoneBadgeEl) {
                            s.zoneBadgeEl.style.display = n > 0 ? 'inline' : 'none';
                            s.zoneBadgeEl.textContent = n + ' 🚛';
                        }
                    });
                }
                paintSidebarBadges();

                // ══════════════════════════════════════════════════════════════
                // Sidebar toggle / search
                // ══════════════════════════════════════════════════════════════
                window.toggleSidebar = function () {
                    const sb = document.getElementById('loc-sidebar');
                    const btn = document.getElementById('sidebar-open-btn');
                    const collapsed = sb.classList.contains('collapsed');
                    if (collapsed) { sb.classList.remove('collapsed'); btn.classList.remove('visible'); }
                    else { sb.classList.add('collapsed'); btn.classList.add('visible'); }
                };

                const searchInput = document.getElementById('loc-search');
                if (searchInput) {
                    searchInput.addEventListener('input', () => {
                        const q = searchInput.value.trim().toLowerCase();
                        const tabs = document.querySelectorAll('.loc-tab');
                        let visibleCount = 0;
                        tabs.forEach(tab => {
                            const name = (tab.querySelector('.loc-tab-name')?.textContent || '').toLowerCase();
                            const match = !q || name.includes(q);
                            tab.style.display = match ? '' : 'none';
                            if (match) visibleCount++;
                        });
                        const emptyMsg = document.getElementById('loc-empty-filtered');
                        if (emptyMsg) emptyMsg.style.display = (tabs.length && visibleCount === 0) ? 'block' : 'none';
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Full-screen map toggle — Esc also exits (native browser
                // behaviour); the button flips to an explicit Exit control so
                // there's always a visible way out, not just a keyboard shortcut.
                // ══════════════════════════════════════════════════════════════
                const mapSectionEl = document.querySelector('.map-section');
                const btnFullscreen = document.getElementById('btn-fullscreen');
                function isFullscreen() { return !!(document.fullscreenElement || document.webkitFullscreenElement); }
                function updateFullscreenBtn() {
                    if (!btnFullscreen) return;
                    const fs = isFullscreen();
                    btnFullscreen.innerHTML = fs ? '✕ Exit Full Screen' : '⛶ Full Screen';
                    btnFullscreen.title = fs ? 'Exit full screen (or press Esc)' : 'View map full screen';
                    if (gmap) setTimeout(() => { google.maps.event.trigger(gmap, 'resize'); }, 80);
                }
                if (btnFullscreen && mapSectionEl) {
                    btnFullscreen.addEventListener('click', () => {
                        if (!isFullscreen()) {
                            const req = mapSectionEl.requestFullscreen || mapSectionEl.webkitRequestFullscreen;
                            if (req) req.call(mapSectionEl);
                        } else {
                            const exit = document.exitFullscreen || document.webkitExitFullscreen;
                            if (exit) exit.call(document);
                        }
                    });
                    document.addEventListener('fullscreenchange', updateFullscreenBtn);
                    document.addEventListener('webkitfullscreenchange', updateFullscreenBtn);
                }

                // ══════════════════════════════════════════════════════════════
                // Fit-all — recentres on every zone, handy after zooming into
                // one location from the sidebar.
                // ══════════════════════════════════════════════════════════════
                const btnFitAll = document.getElementById('btn-fit-all');
                if (btnFitAll) {
                    btnFitAll.addEventListener('click', () => {
                        if (!gmap) return;
                        const bounds = new google.maps.LatLngBounds();
                        let has = false;
                        Object.values(geoShapes).forEach(s => {
                            if (s.zoneBounds && !s.zoneBounds.isEmpty()) { bounds.union(s.zoneBounds); has = true; }
                        });
                        if (has) gmap.fitBounds(bounds, { padding: 60 });
                        document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Show-all TOGGLE:
                //   • If a single zone is currently filtered → clear the filter
                //     so every zone reappears (and remember which zone it was).
                //   • If everything is currently shown → restore whichever zone
                //     was last selected (re-runs the same logic as clicking that
                //     zone in the sidebar: filter, camera, park-info popup, tab
                //     highlight). If nothing was ever selected, this is a no-op.
                // Truck markers are never affected by this filter either way.
                // ══════════════════════════════════════════════════════════════
                function updateShowAllBtn() {
                    if (!btnShowAll) return;
                    if (activeGeoFilter !== null) {
                        btnShowAll.innerHTML = '↺ Show All';
                        btnShowAll.title = 'Show every zone again';
                    } else if (lastSelectedGeoId !== null && geoShapes[lastSelectedGeoId]) {
                        btnShowAll.innerHTML = '↩ Back to Zone';
                        btnShowAll.title = 'Return to the last selected zone';
                    } else {
                        btnShowAll.innerHTML = '↺ Show All';
                        btnShowAll.title = 'Show every zone again';
                    }
                }

                const btnShowAll = document.getElementById('btn-show-all');
                if (btnShowAll) {
                    btnShowAll.addEventListener('click', () => {
                        if (activeGeoFilter !== null) {
                            // Currently showing one zone → reveal all.
                            lastSelectedGeoId = activeGeoFilter;
                            activeGeoFilter = null;
                            applyGeoFilter();
                            document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                            document.getElementById('park-info')?.classList.remove('show');
                            updateShowAllBtn();
                        } else if (lastSelectedGeoId !== null && geoShapes[lastSelectedGeoId]) {
                            // Currently showing all → toggle back to the last zone.
                            zoomToLocation(lastSelectedGeoId);
                        }
                        // If nothing was ever selected, there's nothing to toggle to —
                        // the map is already showing everything, so do nothing.
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Image lightbox
                // ══════════════════════════════════════════════════════════════
                window.openLightbox = function () {
                    const srcImg = document.getElementById('pi-img');
                    if (!srcImg || srcImg.style.display === 'none' || !srcImg.src) return;
                    document.getElementById('lightbox-img').src = srcImg.src;
                    document.getElementById('lightbox-caption').textContent = document.getElementById('pi-img-title').textContent;
                    document.getElementById('img-lightbox').classList.add('show');
                };
                window.closeLightbox = function () {
                    document.getElementById('img-lightbox').classList.remove('show');
                };
                document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

                // ══════════════════════════════════════════════════════════════
                // Zone colour palette
                // ══════════════════════════════════════════════════════════════
                const PALETTE = [
                    { stroke: '#2563eb', fill: 'rgba(37,99,235,.22)' },
                    { stroke: '#16a34a', fill: 'rgba(22,163,74,.22)' },
                    { stroke: '#dc2626', fill: 'rgba(220,38,38,.22)' },
                    { stroke: '#9333ea', fill: 'rgba(147,51,234,.22)' },
                    { stroke: '#ea580c', fill: 'rgba(234,88,12,.22)' },
                    { stroke: '#0891b2', fill: 'rgba(8,145,178,.22)' },
                ];
                function palette(i) { return PALETTE[i % PALETTE.length]; }

                function isDark() {
                    return document.documentElement.classList.contains('dark-theme') ||
                        document.body.classList.contains('dark-theme') ||
                        document.documentElement.getAttribute('data-theme') === 'dark';
                }

                // ══════════════════════════════════════════════════════════════
                // Truck marker factory — shared by zone-assigned devices AND
                // unassigned devices (devices that don't fall inside any
                // geofence). zoneNameForPopup/zoneIdForPopup are null for an
                // unassigned device, so its click popup reads "Zone:
                // Unassigned" instead of a made-up zone name.
                // ══════════════════════════════════════════════════════════════
                function createTruckMarker(device, zoneNameForPopup, zoneIdForPopup) {
                    const isOnline = device.Status === 'online';
                    const dClr = deviceColor(device.Imei);
                    const vPos = { lat: device.Latitude, lng: device.Longitude };

                    const vWrap = document.createElement('div');
                    vWrap.className = 'vehicle-marker';
                    const vIcon = document.createElement('div');
                    vIcon.className = 'vehicle-icon-wrap' + (isOnline ? '' : ' offline-vehicle');
                    vIcon.style.background = dClr;
                    vIcon.style.color = dClr;
                    vIcon.style.boxShadow = `0 4px 14px ${dClr}77`;
                    vIcon.textContent = '🚛';
                    const vLbl = document.createElement('div');
                    vLbl.className = 'vehicle-label' + (isOnline ? '' : ' offline-label');
                    vLbl.style.background = dClr;
                    vLbl.textContent = device.Imei;
                    vWrap.appendChild(vIcon);
                    vWrap.appendChild(vLbl);

                    const vm = new AdvancedMarkerElement({
                        position: vPos, map: gmap, content: vWrap,
                        title: `IMEI: ${device.Imei}`, zIndex: 30
                    });
                    allBounds.extend(vPos); hasBounds = true;

                    vm.element.addEventListener('click', () => {
                        const sc = isOnline ? '#059669' : '#dc2626';
                        const st = isOnline ? 'ONLINE' : 'OFFLINE';
                        const zoneLine = zoneNameForPopup
                            ? `<div style="font-size:11px;color:#555;margin-bottom:3px">Zone: <b>${esc(zoneNameForPopup)}</b></div>`
                            : `<div style="font-size:11px;color:#888;margin-bottom:3px">Zone: <b>Unassigned</b></div>`;
                        sharedInfoWin.setContent(`
                                                        <div style="position:relative;font-family:'Segoe UI',sans-serif;padding:4px 22px 4px 4px;min-width:205px">
                                                            <button onclick="window.__closeSharedInfoWin && window.__closeSharedInfoWin()" title="Close" style="position:absolute;top:2px;right:0;width:18px;height:18px;padding:0;border:none;border-radius:50%;background:rgba(0,0,0,.06);color:#777;font-size:12px;line-height:18px;text-align:center;cursor:pointer">✕</button>
                                                            <b style="font-size:13px">🚛 ${esc(device.Imei)}</b>
                                                            <span style="font-size:10px;background:${isOnline ? 'rgba(16,185,129,.12)' : 'rgba(239,68,68,.12)'};color:${sc};padding:1px 7px;border-radius:4px;margin-left:5px">${st}</span>
                                                            <hr style="border:none;border-top:1px solid #f0f0f0;margin:7px 0"/>
                                                            ${zoneLine}
                                                            <div style="font-size:11px;color:#555;margin-bottom:3px">Position: <b>${device.Latitude.toFixed(6)}, ${device.Longitude.toFixed(6)}</b></div>
                                                            <div style="font-size:11px;color:#555;margin-bottom:8px">Last Seen: <b>${esc(device.LastSeen || '—')}</b></div>
                                                            <a href="/Track/Play?imei=${encodeURIComponent(device.Imei)}" style="font-size:11px;color:${dClr};font-weight:700;text-decoration:none">▶ View Playback →</a>
                                                        </div>`);
                        sharedInfoWin.open(gmap, vm);
                    });

                    deviceMarkers[device.Imei] = { marker: vm, iconEl: vIcon, labelEl: vLbl, geoId: zoneIdForPopup ?? null };
                    return vm;
                }

                let allBounds, hasBounds;
                async function initDashMap() {
                    const { Map, InfoWindow } = await google.maps.importLibrary('maps');
                    ({ AdvancedMarkerElement } = await google.maps.importLibrary('marker'));

                    gmap = new Map(document.getElementById('dash-map'), {
                        center: { lat: 19.076, lng: 72.8777 }, zoom: 13,
                        mapId: 'DEMO_MAP_ID',
                        disableDefaultUI: false, zoomControl: true,
                        mapTypeControl: false, streetViewControl: false, fullscreenControl: false,
                        styles: isDark() ? darkStyle() : []
                    });

                    const applyStyle = () => gmap.setOptions({ styles: isDark() ? darkStyle() : [] });
                    new MutationObserver(applyStyle).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
                    new MutationObserver(applyStyle).observe(document.body, { attributes: true, attributeFilter: ['class'] });

                    sharedInfoWin = new InfoWindow();
                    window.__closeSharedInfoWin = () => sharedInfoWin.close();
                    clearTimeout(mapWatchdog);
                    document.getElementById('dash-map-loading')?.classList.add('gone');
                    allBounds = new google.maps.LatLngBounds();
                    hasBounds = false;

                    // pkByLoc and zoneBoundaryPts were already computed once at
                    // the top of this script (before the map even loads), so
                    // they're simply reused here — that guarantees the polygon
                    // drawn on screen and the containment test used for device
                    // grouping / badge counts always agree with each other.

                    GEO_FENCES.forEach((g, idx) => {
                        if (!g.Latitude || !g.Longitude) return;
                        const center = { lat: g.Latitude, lng: g.Longitude };
                        const clr = palette(idx);
                        const pts = pkByLoc[g.Id] || [];
                        const devHere = devicesByGeo[g.Id] || [];
                        const photo = imgPath(g.Name);

                        // zoneBounds covers the zone's centre marker + every
                        // recorded coordinate, purely for camera fitting — it
                        // never implies a line is drawn to the centre point.
                        const zoneBounds = new google.maps.LatLngBounds();
                        zoneBounds.extend(center);

                        let pathLengthM = 0;
                        let zoneShape = null;              // captured so the zone filter can hide/show it
                        const zoneParkingMarkers = [];     // captured so the zone filter can hide/show them

                        // ── The zone's recorded parking coordinates, ordered by
                        // angle around their own centroid so the boundary can
                        // never cross itself (works for any simple asymmetrical
                        // shape — square, trapezium, irregular blob, whatever
                        // the points actually form), and closed back to the
                        // start. Rendered as a Polygon rather than a plain line
                        // so the whole enclosed area gets a light, medium-tint
                        // (30% opacity) fill in the zone's own color, on top of
                        // the same solid boundary stroke as before. The zone's
                        // own centre/label point is never part of this shape.
                        const ordered = zoneBoundaryPts[g.Id]; // precomputed — same boundary used for containment

                        // clickable:true (on both the polygon and the circle
                        // fallback below) only so hover events fire — Google
                        // Maps disables ALL mouse events, hover included, when
                        // clickable is false. No 'click' listener is attached,
                        // so clicking the fill/edge still does nothing — only
                        // the zone's small marker dot opens the full popup,
                        // exactly like before.
                        if (ordered) {
                            const loopPath = ordered.map(p => ({ lat: p.Latitude, lng: p.Longitude }));
                            zoneShape = new google.maps.Polygon({
                                map: gmap, paths: loopPath, geodesic: true, clickable: true,
                                strokeColor: clr.stroke, strokeOpacity: .85, strokeWeight: 2.5,
                                fillColor: clr.stroke, fillOpacity: .30
                            });
                            pathLengthM = loopDistanceKm(ordered) * 1000;
                        } else {
                            // Fewer than 2 recorded parking points — no polygon
                            // is possible, so this is the SAME boundary that
                            // computeDevicesByGeo used for its circle-fallback
                            // containment test above, drawn for real. This is
                            // what fixes zones showing a lone, unenclosed dot
                            // with nothing marking its actual geofence.
                            const radiusM = Math.max(g.RadiusMeters || 0, 30);
                            zoneShape = new google.maps.Circle({
                                map: gmap, center, radius: radiusM, clickable: true,
                                strokeColor: clr.stroke, strokeOpacity: .85, strokeWeight: 2.5,
                                fillColor: clr.stroke, fillOpacity: .30
                            });
                            const circleBounds = zoneShape.getBounds();
                            if (circleBounds) { zoneBounds.union(circleBounds); allBounds.union(circleBounds); hasBounds = true; }
                        }

                        // ── Hover the geofenced area (polygon OR circle) → show
                        // its name + LIVE vehicle count in a floating tooltip
                        // only while the cursor is over it. The count is looked
                        // up from devicesByGeo at hover time (not captured once
                        // up front) so it stays correct after every refresh.
                        // Nothing is drawn permanently on the map.
                        zoneShape.addListener('mouseover', e => showGeoTooltip(g.Name, (devicesByGeo[g.Id] || []).length, e.domEvent));
                        zoneShape.addListener('mousemove', e => positionGeoTooltip(e.domEvent));
                        zoneShape.addListener('mouseout', () => hideGeoTooltip());

                        // ── Individual parking dots ───────────────────────────
                        pts.forEach((p, pi) => {
                            const pos = { lat: p.Latitude, lng: p.Longitude };
                            zoneBounds.extend(pos); allBounds.extend(pos); hasBounds = true;

                            const isLatest = (pi === 0);
                            const dot = document.createElement('div');
                            const sz = isLatest ? 13 : 8;
                            dot.style.cssText = `
                                                            width:${sz}px; height:${sz}px; border-radius:50%;
                                                            background:${clr.stroke};
                                                            border:${isLatest ? '2.5px solid #fff' : '1.5px solid rgba(255,255,255,.7)'};
                                                            opacity:${isLatest ? '1' : '.75'};
                                                            box-shadow:${isLatest ? `0 0 10px ${clr.stroke}` : 'none'};
                                                            cursor:pointer;`;
                            const dm = new AdvancedMarkerElement({
                                position: pos, map: gmap, content: dot,
                                title: `${g.Name} — ${p.CreatedAt}`,
                                zIndex: isLatest ? 12 : 2
                            });
                            // ── Click a geofence point → show just the ZONE NAME
                            // and the current VEHICLE COUNT for that zone (no
                            // raw lat/lng, no "recorded at" timestamp). The count
                            // is read live from devicesByGeo so it always matches
                            // what's currently on the map, including after a
                            // refresh.
                            dm.element.addEventListener('click', () => {
                                const vehicleCount = (devicesByGeo[g.Id] || []).length;
                                sharedInfoWin.setContent(`
                                                                <div style="position:relative;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:10px 26px 10px 12px;max-width:210px">
                                                                    <button onclick="window.__closeSharedInfoWin && window.__closeSharedInfoWin()" title="Close" style="position:absolute;top:6px;right:6px;width:18px;height:18px;padding:0;border:none;border-radius:50%;background:rgba(0,0,0,.06);color:#777;font-size:12px;line-height:18px;text-align:center;cursor:pointer">✕</button>
                                                                    <div style="display:flex;align-items:center;gap:5px;line-height:1.25">
                                                                        <span style="font-size:12px;flex-shrink:0">🅿</span>
                                                                        <span style="font-size:12.5px;font-weight:600;color:${clr.stroke};letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(g.Name)}</span>
                                                                        ${isLatest ? '<span style="font-size:8px;font-weight:700;color:#b45309;background:rgba(245,158,11,.15);padding:1.5px 5px;border-radius:4px;letter-spacing:.03em;flex-shrink:0">LATEST</span>' : ''}
                                                                    </div>
                                                                    <div style="font-size:10.5px;color:#8a8f98;letter-spacing:.01em;margin-top:3px">Vehicles here <b style="color:#2563eb;font-weight:700">${vehicleCount}</b> 🚛</div>
                                                                </div>`);
                                sharedInfoWin.open(gmap, dm);
                            });
                            zoneParkingMarkers.push(dm);
                        });

                        // ── Zone marker — a small plain dot only (no name text
                        // is drawn on the map anymore). Hovering it — or the
                        // boundary area above — shows the zone's name and
                        // vehicle count in the floating tooltip; clicking it
                        // still opens the full park-info popup, same as before.
                        // Comes from gps_geo_fencing_location, distinct from the
                        // parking coordinate points above, and is deliberately
                        // never connected to them by any line.
                        const lbl = document.createElement('div');
                        lbl.style.cssText = `
                                                        position:relative; width:18px; height:18px; border-radius:50%;
                                                        background:${clr.stroke}; border:2.5px solid #fff; cursor:pointer;
                                                        box-shadow:0 2px 10px ${clr.stroke}88;`;
                        const zoneBadge = document.createElement('span');
                        zoneBadge.style.cssText = `
                                                        position:absolute; top:-9px; right:-12px;
                                                        background:${clr.stroke}; color:#fff; font-size:9px; font-weight:700;
                                                        font-family:'Segoe UI',sans-serif; padding:1px 6px; border-radius:9px;
                                                        white-space:nowrap; display:none; box-shadow:0 1px 5px rgba(0,0,0,.35);`;
                        lbl.appendChild(zoneBadge);
                        const lm = new AdvancedMarkerElement({ position: center, map: gmap, content: lbl, title: g.Name, zIndex: 8 });
                        lm.element.addEventListener('click', () => showParkInfo(g, pts, clr, devicesByGeo[g.Id] || [], pathLengthM));
                        lm.element.addEventListener('mouseenter', ev => showGeoTooltip(g.Name, (devicesByGeo[g.Id] || []).length, ev));
                        lm.element.addEventListener('mousemove', ev => positionGeoTooltip(ev));
                        lm.element.addEventListener('mouseleave', () => hideGeoTooltip());
                        allBounds.extend(center); hasBounds = true;

                        // ── Truck markers for devices inside this zone ────────
                        devHere.forEach(device => createTruckMarker(device, g.Name, g.Id));

                        geoShapes[g.Id] = {
                            pts, geo: g, clr, center, devices: devHere, photo, zoneBounds, pathLengthM,
                            zoneBadgeEl: zoneBadge,
                            boundary: zoneShape,
                            zoneLabelMarker: lm,
                            parkingMarkers: zoneParkingMarkers
                        };
                    });

                    // ── Devices that don't fall inside ANY geofence — these
                    // must still be visible on the map (they're never hidden),
                    // they're simply not tied to a zone's boundary, badge count,
                    // or the zone-filter visibility rules.
                    unassignedDevices.forEach(device => createTruckMarker(device, null, null));

                    if (hasBounds) gmap.fitBounds(allBounds, { padding: 60 });

                    paintSidebarBadges();
                    applyStatusFilterToMap();
                    applyGeoFilter(); // starts as "show everything" (activeGeoFilter === null)
                    markUpdated(true);
                }

                // ══════════════════════════════════════════════════════════════
                // Zone visibility filter — shows only one zone's boundary line,
                // marker and parking dots when activeGeoFilter is set; shows
                // all of them when it's null. Truck markers are untouched on
                // purpose — they should stay visible regardless of the
                // selected zone, and that includes unassigned trucks.
                // ══════════════════════════════════════════════════════════════
                function applyGeoFilter() {
                    Object.keys(geoShapes).forEach(gid => {
                        const s = geoShapes[gid];
                        const visible = activeGeoFilter === null || String(gid) === String(activeGeoFilter);
                        // NOTE: google.maps.Polygon (like Polyline) only responds to
                        // setMap() — unlike AdvancedMarkerElement, it does NOT support
                        // hiding via a direct ".map = null" property assignment (that
                        // silently no-ops and leaves the shape drawn).
                        if (s.boundary) s.boundary.setMap(visible ? gmap : null);
                        if (s.zoneLabelMarker) s.zoneLabelMarker.map = visible ? gmap : null;
                        s.parkingMarkers.forEach(m => { m.map = visible ? gmap : null; });
                        if (!visible) hideGeoTooltip();
                    });
                }

                // ── Zoom to location (sidebar row click) ─────────────────────
                window.zoomToLocation = function (geoId) {
                    const s = geoShapes[geoId];
                    if (!s) return;

                    // Show only this zone's boundary/marker/parking dots —
                    // everything else's static map elements are hidden. Truck
                    // markers are left exactly as they are (unaffected by this
                    // filter).
                    activeGeoFilter = geoId;
                    lastSelectedGeoId = geoId;
                    applyGeoFilter();
                    updateShowAllBtn();

                    document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                    const tab = document.querySelector(`.loc-tab[data-geo-id="${geoId}"]`);
                    if (tab) tab.classList.add('active');

                    if (s.zoneBounds && !s.zoneBounds.isEmpty())
                        gmap.fitBounds(s.zoneBounds, { padding: 90 });
                    else { gmap.panTo(s.center); gmap.setZoom(17); }

                    showParkInfo(s.geo, s.pts, s.clr, devicesByGeo[geoId] || [], s.pathLengthM);
                };

                // ── IMEI table click → focus zone ────────────────────────────
                window.focusDeviceOnMap = function (imei, geoFenceId) {
                    document.getElementById('dash-map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => zoomToLocation(geoFenceId), 300);
                };

                // ── Park info popup ───────────────────────────────────────────
                function showParkInfo(g, pts, clr, devices, pathLengthM) {
                    const latest = pts.length ? pts[0] : null;
                    const photo = imgPath(g.Name);

                    const imgEl = document.getElementById('pi-img');
                    const placeholderEl = document.getElementById('pi-img-placeholder');
                    const titleEl = document.getElementById('pi-img-title');
                    const expandBtn = document.getElementById('pi-img-expand');

                    titleEl.textContent = g.Name;

                    if (photo) {
                        imgEl.src = photo;
                        imgEl.style.display = 'block';
                        placeholderEl.style.display = 'none';
                        expandBtn.style.display = 'flex';
                    } else {
                        imgEl.style.display = 'none';
                        placeholderEl.style.display = 'flex';
                        expandBtn.style.display = 'none';
                    }

                    document.getElementById('pi-geo').textContent = g.RadiusMeters + ' m';
                    document.getElementById('pi-cnt').textContent = pts.length;
                    document.getElementById('pi-path').textContent = pts.length >= 2 ? Math.round(pathLengthM || 0) + ' m' : '—';
                    document.getElementById('pi-last').textContent = latest ? latest.CreatedAt : 'None';
                    document.getElementById('pi-devcnt').textContent = devices ? devices.length : 0;

                    if (pts.length >= 2) {
                        const lats = pts.map(p => p.Latitude);
                        const lngs = pts.map(p => p.Longitude);
                        const dlat = (Math.max(...lats) - Math.min(...lats)) * 111000;
                        const dlng = (Math.max(...lngs) - Math.min(...lngs)) * 111000 * Math.cos(lats[0] * Math.PI / 180);
                        document.getElementById('pi-area').textContent = Math.round(dlat) + ' × ' + Math.round(dlng) + ' m';
                    } else {
                        document.getElementById('pi-area').textContent = '—';
                    }

                    const vRow = document.getElementById('pi-vehicle-row');
                    const vInfo = document.getElementById('pi-vehicle-info');
                    if (devices && devices.length) {
                        vInfo.innerHTML = devices.map(d => {
                            const on = d.Status === 'online';
                            const c = deviceColor(d.Imei);
                            return `<span style="display:inline-flex;align-items:center;gap:5px">
                                                            <span style="width:9px;height:9px;border-radius:50%;background:${c};flex-shrink:0"></span>
                                                            🚛 <b>${esc(d.Imei)}</b>
                                                            <span style="color:${on ? '#059669' : '#dc2626'};font-weight:700;font-size:10px">${on ? '●' : '○'}</span>
                                                        </span>`;
                        }).join('');
                        vRow.style.display = 'flex';
                    } else {
                        vInfo.textContent = 'No devices currently in this zone';
                        vRow.style.display = 'flex';
                    }

                    document.getElementById('park-info').classList.add('show');
                }

                // ══════════════════════════════════════════════════════════════
                // STATUS FILTER (All / Online / Offline) — driven only by the
                // stat cards at the top now (the legend chip row was removed).
                // Drives both the device table rows and which truck markers
                // are shown on the map.
                // ══════════════════════════════════════════════════════════════
                let statusFilter = 'all';

                window.setStatusFilter = function (f) {
                    statusFilter = f;
                    document.querySelectorAll('.dash-card.filterable').forEach(c => c.classList.toggle('filter-active', c.dataset.filter === f));
                    applyStatusFilterToTable();
                    applyStatusFilterToMap();
                };

                document.querySelectorAll('.dash-card.filterable').forEach(card => {
                    card.addEventListener('click', () => setStatusFilter(card.dataset.filter));
                });

                function applyStatusFilterToTable() {
                    const rows = document.querySelectorAll('#device-tbody tr[data-status]');
                    let visible = 0;
                    rows.forEach(r => {
                        const match = statusFilter === 'all' || r.dataset.status === statusFilter;
                        r.classList.toggle('row-hidden', !match);
                        if (match) visible++;
                    });
                    const countLbl = document.getElementById('tbl-head-count');
                    if (countLbl) countLbl.textContent = rows.length ? `Showing ${visible} of ${rows.length}` : '';
                    const emptyState = document.getElementById('tbl-filter-empty');
                    if (emptyState) emptyState.style.display = (rows.length > 0 && visible === 0) ? 'block' : 'none';
                }

                function applyStatusFilterToMap() {
                    Object.values(deviceMarkers).forEach(rec => {
                        const status = rec.iconEl.classList.contains('offline-vehicle') ? 'offline' : 'online';
                        const match = statusFilter === 'all' || status === statusFilter;
                        rec.marker.map = match ? gmap : null;
                    });
                }
                applyStatusFilterToTable();

                // ══════════════════════════════════════════════════════════════
                // LIVE REFRESH — re-pulls /Home/DashboardMapJson and updates
                // existing truck marker positions/status, the stat cards, the
                // device table rows, and the sidebar/zone device-count badges.
                // Zone boundary lines are unaffected (they only depend on the
                // static gps_parking_location_coordinates rows, not on devices).
                // A device that newly appears (not previously known) still gets
                // a truck marker created for it here — whether or not it falls
                // inside a zone — so nothing is silently dropped from the map.
                // ══════════════════════════════════════════════════════════════
                let refreshing = false;

                function markUpdated(ok) {
                    const wrap = document.getElementById('map-last-updated');
                    const txt = document.getElementById('map-last-updated-text');
                    if (!wrap || !txt) return;
                    wrap.classList.toggle('stale', !ok);
                    txt.textContent = ok ? ('Updated ' + new Date().toLocaleTimeString()) : 'Update failed — will retry';
                }

                async function refreshDevices() {
                    if (refreshing) return;
                    refreshing = true;
                    const btn = document.getElementById('btn-refresh');
                    if (btn) { btn.classList.add('spinning'); btn.disabled = true; }

                    try {
                        const res = await fetch('/Home/DashboardMapJson?_=' + Date.now(), { cache: 'no-store', headers: { 'Cache-Control': 'no-cache' } });
                        const d = await res.json();
                        if (!d.ok) throw new Error(d.error || 'Refresh failed');

                        DEVICES = d.devices || [];
                        const grouping = computeDevicesByGeo(DEVICES);
                        devicesByGeo = grouping.byGeo;
                        unassignedDevices = grouping.unassigned;

                        // imei -> geoId lookup for this refresh cycle, so a
                        // brand-new device we haven't drawn yet gets its
                        // zone name/id wired up correctly on creation.
                        const imeiToZone = {};
                        Object.keys(devicesByGeo).forEach(gid => {
                            devicesByGeo[gid].forEach(d2 => { imeiToZone[d2.Imei] = gid; });
                        });

                        let onlineCount = 0;
                        DEVICES.forEach(dev => {
                            if (dev.Status === 'online') onlineCount++;

                            let rec = deviceMarkers[dev.Imei];
                            if (!rec && dev.Latitude && dev.Longitude) {
                                // Newly-seen device — still shown, zone-assigned
                                // or not.
                                const gid = imeiToZone[dev.Imei];
                                const zoneName = gid && geoShapes[gid] ? geoShapes[gid].geo.Name : null;
                                createTruckMarker(dev, zoneName, gid || null);
                                rec = deviceMarkers[dev.Imei];
                            }
                            if (rec) {
                                rec.marker.position = { lat: dev.Latitude, lng: dev.Longitude };
                                const online = dev.Status === 'online';
                                rec.iconEl.classList.toggle('offline-vehicle', !online);
                                rec.labelEl.classList.toggle('offline-label', !online);
                            }

                            const row = document.getElementById('devrow-' + dev.Imei);
                            if (row) {
                                row.dataset.status = dev.Status;
                                const badgeCell = document.getElementById('devbadge-' + dev.Imei);
                                if (badgeCell) badgeCell.innerHTML = `<span class="badge badge-${dev.Status}">${dev.Status === 'online' ? '● Online' : '○ Offline'}</span>`;
                                const seenCell = document.getElementById('devseen-' + dev.Imei);
                                if (seenCell) seenCell.textContent = dev.LastSeen;
                                const locCell = document.getElementById('devloc-' + dev.Imei);
                                if (locCell) locCell.textContent = dev.Name || '—';
                            }
                        });

                        document.getElementById('stat-total').textContent = DEVICES.length;
                        document.getElementById('stat-online').textContent = onlineCount;
                        document.getElementById('stat-offline').textContent = DEVICES.length - onlineCount;

                        paintSidebarBadges();
                        applyStatusFilterToTable();
                        applyStatusFilterToMap();
                        markUpdated(true);
                    } catch (e) {
                        console.error('Device refresh failed:', e);
                        markUpdated(false);
                    } finally {
                        refreshing = false;
                        if (btn) { btn.classList.remove('spinning'); btn.disabled = false; }
                    }
                }

                document.getElementById('btn-refresh')?.addEventListener('click', refreshDevices);
                setInterval(refreshDevices, 30000);

                // ══════════════════════════════════════════════════════════════
                // Styling helper
                // ══════════════════════════════════════════════════════════════
                function darkStyle() {
                    return [
                        { elementType: 'geometry', stylers: [{ color: '#0f1117' }] },
                        { elementType: 'labels.text.stroke', stylers: [{ color: '#0f1117' }] },
                        { elementType: 'labels.text.fill', stylers: [{ color: '#4e5568' }] },
                        { featureType: 'administrative.locality', elementType: 'labels.text.fill', stylers: [{ color: '#9aa3b0' }] },
                        { featureType: 'poi.park', elementType: 'geometry', stylers: [{ color: '#151c1e' }] },
                        { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#1e2330' }] },
                        { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#243044' }] },
                        { featureType: 'road.highway', elementType: 'labels.text.fill', stylers: [{ color: '#f3d19c' }] },
                        { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#070c14' }] },
                    ];
                }

                window.initDashMap = initDashMap;

            } catch (err) {
                clearTimeout(mapWatchdog);
                console.error('Dashboard init error:', err);
                showMapError('Dashboard failed to initialize.');
            }
        })();
    </script>

    @if (!string.IsNullOrEmpty(mapsKey))
    {
        <text>
            <script src="https://maps.googleapis.com/maps/api/js?key=@mapsKey&callback=initDashMap&libraries=marker&loading=async" async defer></script>
        </text>
    }
}
