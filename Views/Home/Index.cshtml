                                <a href="/Track/Play?imei=@d.Imei" style="font-size:12px;color:#6366f1;text-decoration:none;font-weight:600">▶ Play</a>
                                &nbsp;·&nbsp;
                                <a href="/Track/Map" style="font-size:12px;color:#10b981;text-decoration:none;font-weight:600">◈ Live</a>
                            </td>
