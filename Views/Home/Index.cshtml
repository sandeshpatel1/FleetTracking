</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // ── Safety net ────────────────────────────────────────────────
            function showMapError(msg) {
                const loading = document.getElementById('dash-map-loading');
                if (!loading) return;
                loading.classList.remove('gone');
                loading.innerHTML = `<div style="color:#dc2626;font-family:monospace;font-size:12px;text-align:center;padding:20px;max-width:320px;line-height:1.6">
                                                ⚠ ${msg}<br><small style="color:#999">Check the browser console (F12) for details.</small>
                                            </div>`;
            }
            const mapWatchdog = setTimeout(() => showMapError('Map is taking too long to load.'), 15000);

            try {

                const GEO_FENCES = @Html.Raw(geoJson);
                const PARKING = @Html.Raw(parkJson);
                let DEVICES = @Html.Raw(devJson);

                // ══════════════════════════════════════════════════════════════
                // Small helpers
                // ══════════════════════════════════════════════════════════════
                function imgPath(name) {
                    if (!name) return '';
                    return `/assest/${encodeURIComponent(name)}.jpeg`;
                }

                const DEVICE_COLORS = ['#2563eb', '#dc2626', '#16a34a', '#9333ea', '#ea580c', '#0891b2', '#db2777', '#65a30d', '#0d9488', '#7c3aed', '#f59e0b', '#4f46e5'];
                function deviceColor(imei) {
                    let h = 0;
                    for (let i = 0; i < imei.length; i++) h = (h * 31 + imei.charCodeAt(i)) >>> 0;
                    return DEVICE_COLORS[h % DEVICE_COLORS.length];
                }

                function haversineKm(lat1, lng1, lat2, lng2) {
                    const R = 6371, toRad = x => x * Math.PI / 180;
                    const dLat = toRad(lat2 - lat1), dLng = toRad(lng2 - lng1);
                    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
                    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                }

                function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

                // ══════════════════════════════════════════════════════════════
                // ZONE GROUPS + TYPES — derived from the zone NAME (no DB column).
                //
                // COLOUR belongs to the GROUP, so every sub-type in a group is
                // drawn in exactly the same colour:
                //   Parking        = Parking + Road Parking
                //   Loading Points = Loading + Unloading
                //   Weighbridge    = Weighbridge
                //   Roads          = Road
                //   Other          = Plant + Other
                //
                // To change a colour, edit the single `stroke` in ZONE_GROUPS.
                // ══════════════════════════════════════════════════════════════
                const hasWord = (n, w) => new RegExp('\\b' + w + '\\b').test(n);

                const ZONE_GROUPS = {
                    parking: { label: 'Parking', stroke: '#2563eb', fillOp: .30 },
                    loading: { label: 'Loading Points', stroke: '#9333ea', fillOp: .30 },
                    weighbridge: { label: 'Weighbridge', stroke: '#0891b2', fillOp: .30 },
                    road: { label: 'Roads', stroke: '#6b7280', fillOp: .20 },
                    other: { label: 'Other', stroke: '#db2777', fillOp: .30 }
                };
                const ZONE_GROUP_ORDER = Object.keys(ZONE_GROUPS);

                // Sub-types only decide WHICH group a zone belongs to (and its
                // label). ORDER MATTERS: the FIRST type whose test matches wins,
                // so specific types sit above broader ones:
                //
                //   "CCL Road Parking"           → Road Parking (ROAD + PARKING)
                //   "Zone 1 - Unloading Point"   → Unloading (before Loading,
                //                                  because UNLOADING contains LOADING)
                //   "SPD Loading Point 3"        → Loading
                //   "Weighbridge Gate no 1"      → Weighbridge
                //   "Parking - Gate 03 Entry"    → Parking
                //   "Gate No - 2 Road"           → Road
                //   "CPP Plant"                  → Plant
                //   "Bus Stand"                  → Other
                const ZONE_TYPES = {
                    roadparking: { group: 'parking', label: 'Road Parking', test: n => hasWord(n, 'ROAD') && n.includes('PARKING') },
                    unloading: { group: 'loading', label: 'Unloading', test: n => n.includes('UNLOADING') },
                    loading: { group: 'loading', label: 'Loading', test: n => n.includes('LOADING') },
                    weighbridge: { group: 'weighbridge', label: 'Weighbridge', test: n => n.includes('WEIGHBRIDGE') },
                    parking: { group: 'parking', label: 'Parking', test: n => n.includes('PARKING') },
                    road: { group: 'road', label: 'Road', test: n => hasWord(n, 'ROAD') },
                    plant: { group: 'other', label: 'Plant', test: n => n.includes('PLANT') },
                    other: { group: 'other', label: 'Other', test: () => true }
                };
                const ZONE_TYPE_ORDER = Object.keys(ZONE_TYPES);

                function zoneTypeKey(name) {
                    const n = (name || '').toUpperCase();
                    for (const key of ZONE_TYPE_ORDER)
                        if (ZONE_TYPES[key].test(n)) return key;
                    return 'other';
                }
                function zoneGroupKey(name) { return ZONE_TYPES[zoneTypeKey(name)].group; }
                function zoneTypeLabel(name) { return ZONE_TYPES[zoneTypeKey(name)].label; }

                // Resolve a zone name to its GROUP's colour.
                function zoneStyle(name) {
                    const t = ZONE_TYPES[zoneTypeKey(name)];
                    const grp = ZONE_GROUPS[t.group];
                    return { group: t.group, label: t.label, stroke: grp.stroke, fillOp: grp.fillOp };
                }

                function hexToRgba(hex, a) {
                    const v = parseInt(hex.slice(1), 16);
                    return `rgba(${v >> 16},${(v >> 8) & 255},${v & 255},${a})`;
                }

                // Boundary line thickness.
                const LINE_WEIGHT = 2;     // px — boundary stroke

                // ══════════════════════════════════════════════════════════════
                // Geofence hover tooltip — zone name · type · live vehicle count,
                // shown only while the cursor is over the zone area. Nothing is drawn permanently on the map.
                // ══════════════════════════════════════════════════════════════
                const geoTooltipEl = document.getElementById('geo-name-tooltip');
                function showGeoTooltip(name, count, domEvent) {
                    if (!geoTooltipEl) return;
                    const countText = (count !== null && count !== undefined) ? ` • ${count} 🚛` : '';
                    geoTooltipEl.textContent = (name || 'Zone') + ' · ' + zoneTypeLabel(name) + countText;
                    geoTooltipEl.classList.add('show');
                    positionGeoTooltip(domEvent);
                }
                function positionGeoTooltip(domEvent) {
                    if (!geoTooltipEl || !domEvent) return;
                    const mapEl = document.getElementById('dash-map');
                    if (!mapEl) return;
                    const rect = mapEl.getBoundingClientRect();
                    const cx = domEvent.clientX, cy = domEvent.clientY;
                    if (cx == null || cy == null) return;
                    geoTooltipEl.style.left = (cx - rect.left + 14) + 'px';
                    geoTooltipEl.style.top = (cy - rect.top - 12) + 'px';
                }
                function hideGeoTooltip() {
                    if (geoTooltipEl) geoTooltipEl.classList.remove('show');
                }

                // ══════════════════════════════════════════════════════════════
                // BOUNDARY = TABLE SEQUENCE.
                // Each zone's points are sorted by Id ascending (the order they
                // sit in gps_parking_location_coordinates). Point 1 → 2 → 3 …
                // → last, and the polygon closes back to point 1. No hull, no
                // nearest-neighbour, no angular sorting, no extra points.
                // ══════════════════════════════════════════════════════════════
                function loopDistanceKm(ordered) {
                    if (ordered.length < 2) return 0;
                    let d = 0;
                    for (let i = 0; i < ordered.length; i++) {
                        const a = ordered[i], b = ordered[(i + 1) % ordered.length]; // wraps → closes the loop
                        d += haversineKm(a.Latitude, a.Longitude, b.Latitude, b.Longitude);
                    }
                    return d;
                }

                // Ray-casting point-in-polygon (lat = y, lng = x) — decides
                // "is this device inside the SHAPE YOU SEE DRAWN".
                function pointInPolygon(lat, lng, polyPts) {
                    let inside = false;
                    for (let i = 0, j = polyPts.length - 1; i < polyPts.length; j = i++) {
                        const yi = polyPts[i].Latitude, xi = polyPts[i].Longitude;
                        const yj = polyPts[j].Latitude, xj = polyPts[j].Longitude;
                        const intersects = ((yi > lat) !== (yj > lat)) &&
                            (lng < (xj - xi) * (lat - yi) / (yj - yi) + xi);
                        if (intersects) inside = !inside;
                    }
                    return inside;
                }

                // Group points by zone, then sort each zone by table Id.
                const pkByLoc = {};
                PARKING.forEach(p => {
                    const k = p.ParkingLocationId;
                    if (!pkByLoc[k]) pkByLoc[k] = [];
                    pkByLoc[k].push(p);
                });
                Object.keys(pkByLoc).forEach(k => pkByLoc[k].sort((a, b) => a.Id - b.Id));

                // Computed ONCE so the drawn polygon and the containment test
                // used for device grouping always agree with each other.
                // Fewer than 3 points → null → circle fallback.
                const zoneBoundaryPts = {};
                GEO_FENCES.forEach(g => {
                    const pts = pkByLoc[g.Id] || [];
                    zoneBoundaryPts[g.Id] = pts.length >= 3 ? pts : null;
                });

                // ══════════════════════════════════════════════════════════════
                // Devices-per-geofence. Each device belongs to AT MOST ONE zone
                // (the one whose real boundary it is inside). Devices inside no
                // zone are returned as "unassigned" and are still drawn.
                // ══════════════════════════════════════════════════════════════
                function computeDevicesByGeo(devices) {
                    const byGeo = {};
                    GEO_FENCES.forEach(g => { byGeo[g.Id] = []; });
                    const unassigned = [];

                    devices.forEach(d => {
                        if (!d.Latitude || !d.Longitude) return;

                        let bestId = null, bestDistKm = Infinity;
                        GEO_FENCES.forEach(g => {
                            if (!g.Latitude || !g.Longitude) return;

                            const boundary = zoneBoundaryPts[g.Id];
                            let contained;
                            if (boundary) {
                                contained = pointInPolygon(d.Latitude, d.Longitude, boundary);
                            } else {
                                const radiusKm = Math.max(g.RadiusMeters || 0, 30) / 1000;
                                contained = haversineKm(g.Latitude, g.Longitude, d.Latitude, d.Longitude) <= radiusKm;
                            }
                            if (!contained) return;

                            const distKm = haversineKm(g.Latitude, g.Longitude, d.Latitude, d.Longitude);
                            if (distKm < bestDistKm) { bestDistKm = distKm; bestId = g.Id; }
                        });

                        if (bestId !== null) byGeo[bestId].push(d);
                        else unassigned.push(d);
                    });

                    return { byGeo, unassigned };
                }
                const initialGrouping = computeDevicesByGeo(DEVICES);
                let devicesByGeo = initialGrouping.byGeo;
                let unassignedDevices = initialGrouping.unassigned;

                // Declared up-front so nothing reads them before initialisation.
                let gmap, sharedInfoWin, AdvancedMarkerElement;
                const geoShapes = {};      // geoId -> { pts, geo, clr, type, center, devices, photo, zoneBounds, pathLengthM, boundary, parkingMarkers }
                const deviceMarkers = {};  // imei  -> { marker, iconEl, labelEl, geoId }

                // null = all zones shown; a geoId = only that zone shown.
                // Truck markers are never affected by these filters.
                let activeGeoFilter = null;
                // null = all zone groups shown; a group key = only that group.
                let activeTypeFilter = null;
                let lastSelectedGeoId = null;

                function paintSidebarBadges() {
                    Object.keys(devicesByGeo).forEach(gid => {
                        const badge = document.getElementById('devcnt-' + gid);
                        if (!badge) return;
                        const n = devicesByGeo[gid].length;
                        badge.style.display = 'inline-flex';
                        badge.textContent = n + ' 🚛';
                        badge.style.background = n > 0 ? 'rgba(37,99,235,.12)' : 'rgba(0,0,0,.06)';
                        badge.style.color = n > 0 ? '#2563eb' : '#999';
                    });
                }
                paintSidebarBadges();

                // ══════════════════════════════════════════════════════════════
                // Zone GROUP legend (also the group filter) + sidebar stripes/badges
                // One colour dot per group.
                // ══════════════════════════════════════════════════════════════
                function paintLegend() {
                    const counts = {};           // group -> number of zones
                    GEO_FENCES.forEach(g => {
                        const grp = zoneGroupKey(g.Name);
                        counts[grp] = (counts[grp] || 0) + 1;
                    });
                    const el = document.getElementById('zone-legend');
                    if (!el) return;
                    el.innerHTML = ZONE_GROUP_ORDER
                        .filter(k => counts[k])
                        .map(k => `<span class="leg-item leg-type ${activeTypeFilter === k ? 'active' : ''}"
                                                  title="Click to show only ${esc(ZONE_GROUPS[k].label)}"
                                                  onclick="setTypeFilter('${k}')">
                                                <span class="leg-dot" style="background:${ZONE_GROUPS[k].stroke}"></span>${esc(ZONE_GROUPS[k].label)} (${counts[k]})
                                           </span>`).join('');
                }

                function paintSidebarTypes() {
                    GEO_FENCES.forEach(g => {
                        const tab = document.querySelector(`.loc-tab[data-geo-id="${g.Id}"]`);
                        if (!tab) return;
                        const s = zoneStyle(g.Name);
                        tab.style.setProperty('--zt', s.stroke);
                        tab.dataset.type = s.group;
                        if (!tab.querySelector('.zt-badge')) {
                            const b = document.createElement('span');
                            b.className = 'zt-badge';
                            b.style.background = s.stroke;
                            b.textContent = s.label;
                            const sub = tab.querySelector('.loc-tab-sub');
                            if (sub) sub.appendChild(b);
                        }
                    });
                }

                window.setTypeFilter = function (k) {
                    activeTypeFilter = (activeTypeFilter === k) ? null : k;   // click again to clear
                    activeGeoFilter = null;
                    applyGeoFilter();
                    updateShowAllBtn();
                    paintLegend();
                    document.querySelectorAll('.loc-tab').forEach(tab => {
                        tab.classList.remove('active');
                        tab.classList.toggle('type-hidden', activeTypeFilter !== null && tab.dataset.type !== activeTypeFilter);
                    });
                    document.getElementById('park-info')?.classList.remove('show');

                    // fit the camera to the zones that are now visible
                    if (!gmap) return;
                    const b = new google.maps.LatLngBounds();
                    let has = false;
                    Object.values(geoShapes).forEach(s => {
                        if ((activeTypeFilter === null || s.type === activeTypeFilter) && s.zoneBounds && !s.zoneBounds.isEmpty()) {
                            b.union(s.zoneBounds); has = true;
                        }
                    });
                    if (has) gmap.fitBounds(b, { padding: 60 });
                };

                paintLegend();
                paintSidebarTypes();

                // ══════════════════════════════════════════════════════════════
                // Sidebar toggle / search
                // ══════════════════════════════════════════════════════════════
                window.toggleSidebar = function () {
                    const sb = document.getElementById('loc-sidebar');
                    const btn = document.getElementById('sidebar-open-btn');
                    const collapsed = sb.classList.contains('collapsed');
                    if (collapsed) { sb.classList.remove('collapsed'); btn.classList.remove('visible'); }
                    else { sb.classList.add('collapsed'); btn.classList.add('visible'); }
                };

                const searchInput = document.getElementById('loc-search');
                if (searchInput) {
                    searchInput.addEventListener('input', () => {
                        const q = searchInput.value.trim().toLowerCase();
                        const tabs = document.querySelectorAll('.loc-tab');
                        let visibleCount = 0;
                        tabs.forEach(tab => {
                            const name = (tab.querySelector('.loc-tab-name')?.textContent || '').toLowerCase();
                            const match = !q || name.includes(q);
                            tab.style.display = match ? '' : 'none';
                            if (match && !tab.classList.contains('type-hidden')) visibleCount++;
                        });
                        const emptyMsg = document.getElementById('loc-empty-filtered');
                        if (emptyMsg) emptyMsg.style.display = (tabs.length && visibleCount === 0) ? 'block' : 'none';
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Full-screen map toggle
                // ══════════════════════════════════════════════════════════════
                const mapSectionEl = document.querySelector('.map-section');
                const btnFullscreen = document.getElementById('btn-fullscreen');
                function isFullscreen() { return !!(document.fullscreenElement || document.webkitFullscreenElement); }
                function updateFullscreenBtn() {
                    if (!btnFullscreen) return;
                    const fs = isFullscreen();
                    btnFullscreen.innerHTML = fs ? '✕ Exit Full Screen' : '⛶ Full Screen';
                    btnFullscreen.title = fs ? 'Exit full screen (or press Esc)' : 'View map full screen';
                    if (gmap) setTimeout(() => { google.maps.event.trigger(gmap, 'resize'); }, 80);
                }
                if (btnFullscreen && mapSectionEl) {
                    btnFullscreen.addEventListener('click', () => {
                        if (!isFullscreen()) {
                            const req = mapSectionEl.requestFullscreen || mapSectionEl.webkitRequestFullscreen;
                            if (req) req.call(mapSectionEl);
                        } else {
                            const exit = document.exitFullscreen || document.webkitExitFullscreen;
                            if (exit) exit.call(document);
                        }
                    });
                    document.addEventListener('fullscreenchange', updateFullscreenBtn);
                    document.addEventListener('webkitfullscreenchange', updateFullscreenBtn);
                }

                // ══════════════════════════════════════════════════════════════
                // Fit-all
                // ══════════════════════════════════════════════════════════════
                const btnFitAll = document.getElementById('btn-fit-all');
                if (btnFitAll) {
                    btnFitAll.addEventListener('click', () => {
                        if (!gmap) return;
                        const bounds = new google.maps.LatLngBounds();
                        let has = false;
                        Object.values(geoShapes).forEach(s => {
                            if (activeTypeFilter !== null && s.type !== activeTypeFilter) return;
                            if (s.zoneBounds && !s.zoneBounds.isEmpty()) { bounds.union(s.zoneBounds); has = true; }
                        });
                        if (has) gmap.fitBounds(bounds, { padding: 60 });
                        document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Show-all TOGGLE
                // ══════════════════════════════════════════════════════════════
                function updateShowAllBtn() {
                    if (!btnShowAll) return;
                    if (activeGeoFilter !== null) {
                        btnShowAll.innerHTML = '↺ Show All';
                        btnShowAll.title = 'Show every zone again';
                    } else if (lastSelectedGeoId !== null && geoShapes[lastSelectedGeoId]) {
                        btnShowAll.innerHTML = '↩ Back to Zone';
                        btnShowAll.title = 'Return to the last selected zone';
                    } else {
                        btnShowAll.innerHTML = '↺ Show All';
                        btnShowAll.title = 'Show every zone again';
                    }
                }

                const btnShowAll = document.getElementById('btn-show-all');
                if (btnShowAll) {
                    btnShowAll.addEventListener('click', () => {
                        if (activeGeoFilter !== null) {
                            lastSelectedGeoId = activeGeoFilter;
                            activeGeoFilter = null;
                            applyGeoFilter();
                            document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                            document.getElementById('park-info')?.classList.remove('show');
                            updateShowAllBtn();
                        } else if (activeTypeFilter !== null) {
                            setTypeFilter(activeTypeFilter);   // clears the group filter
                        } else if (lastSelectedGeoId !== null && geoShapes[lastSelectedGeoId]) {
                            zoomToLocation(lastSelectedGeoId);
                        }
                    });
                }

                // ══════════════════════════════════════════════════════════════
                // Image lightbox
                // ══════════════════════════════════════════════════════════════
                window.openLightbox = function () {
                    const srcImg = document.getElementById('pi-img');
                    if (!srcImg || srcImg.style.display === 'none' || !srcImg.src) return;
                    document.getElementById('lightbox-img').src = srcImg.src;
                    document.getElementById('lightbox-caption').textContent = document.getElementById('pi-img-title').textContent;
                    document.getElementById('img-lightbox').classList.add('show');
                };
                window.closeLightbox = function () {
                    document.getElementById('img-lightbox').classList.remove('show');
                };
                document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

                function isDark() {
                    return document.documentElement.classList.contains('dark-theme') ||
                        document.body.classList.contains('dark-theme') ||
                        document.documentElement.getAttribute('data-theme') === 'dark';
                }

                // ══════════════════════════════════════════════════════════════
                // Truck marker factory
                // ══════════════════════════════════════════════════════════════
                function createTruckMarker(device, zoneNameForPopup, zoneIdForPopup) {
                    const isOnline = device.Status === 'online';
                    const dClr = deviceColor(device.Imei);
                    const vPos = { lat: device.Latitude, lng: device.Longitude };

                    const vWrap = document.createElement('div');
                    vWrap.className = 'vehicle-marker';
                    const vIcon = document.createElement('div');
                    vIcon.className = 'vehicle-icon-wrap' + (isOnline ? '' : ' offline-vehicle');
                    vIcon.style.background = dClr;
                    vIcon.style.color = dClr;
                    vIcon.style.boxShadow = `0 4px 14px ${dClr}77`;
                    vIcon.textContent = '🚛';
                    const vLbl = document.createElement('div');
                    vLbl.className = 'vehicle-label' + (isOnline ? '' : ' offline-label');
                    vLbl.style.background = dClr;
                    vLbl.textContent = device.Imei;
                    vWrap.appendChild(vIcon);
                    vWrap.appendChild(vLbl);

                    const vm = new AdvancedMarkerElement({
                        position: vPos, map: gmap, content: vWrap,
                        title: `IMEI: ${device.Imei}`, zIndex: 30
                    });
                    allBounds.extend(vPos); hasBounds = true;

                    vm.element.addEventListener('click', () => {
                        const sc = isOnline ? '#059669' : '#dc2626';
                        const st = isOnline ? 'ONLINE' : 'OFFLINE';
                        const zoneLine = zoneNameForPopup
                            ? `<div style="font-size:11px;color:#555;margin-bottom:3px">Zone: <b>${esc(zoneNameForPopup)}</b> <span style="color:#999">(${esc(zoneTypeLabel(zoneNameForPopup))})</span></div>`
                            : `<div style="font-size:11px;color:#888;margin-bottom:3px">Zone: <b>Unassigned</b></div>`;
                        sharedInfoWin.setContent(`
                                    <div style="position:relative;font-family:'Segoe UI',sans-serif;padding:4px 22px 4px 4px;min-width:205px">
                                        <button onclick="window.__closeSharedInfoWin && window.__closeSharedInfoWin()" title="Close" style="position:absolute;top:2px;right:0;width:18px;height:18px;padding:0;border:none;border-radius:50%;background:rgba(0,0,0,.06);color:#777;font-size:12px;line-height:18px;text-align:center;cursor:pointer">✕</button>
                                        <b style="font-size:13px">🚛 ${esc(device.Imei)}</b>
                                        <span style="font-size:10px;background:${isOnline ? 'rgba(16,185,129,.12)' : 'rgba(239,68,68,.12)'};color:${sc};padding:1px 7px;border-radius:4px;margin-left:5px">${st}</span>
                                        <hr style="border:none;border-top:1px solid #f0f0f0;margin:7px 0"/>
                                        ${zoneLine}
                                        <div style="font-size:11px;color:#555;margin-bottom:3px">Position: <b>${device.Latitude.toFixed(6)}, ${device.Longitude.toFixed(6)}</b></div>
                                        <div style="font-size:11px;color:#555;margin-bottom:8px">Last Seen: <b>${esc(device.LastSeen || '—')}</b></div>
                                        <a href="/Track/Play?imei=${encodeURIComponent(device.Imei)}" style="font-size:11px;color:${dClr};font-weight:700;text-decoration:none">▶ View Playback →</a>
                                    </div>`);
                        sharedInfoWin.open(gmap, vm);
                    });

                    deviceMarkers[device.Imei] = { marker: vm, iconEl: vIcon, labelEl: vLbl, geoId: zoneIdForPopup ?? null };
                    return vm;
                }

                let allBounds, hasBounds;
                async function initDashMap() {
                    const { Map, InfoWindow } = await google.maps.importLibrary('maps');
                    ({ AdvancedMarkerElement } = await google.maps.importLibrary('marker'));

                    gmap = new Map(document.getElementById('dash-map'), {
                        center: { lat: 19.076, lng: 72.8777 }, zoom: 13,
                        mapId: 'DEMO_MAP_ID',
                        disableDefaultUI: false, zoomControl: true,
                        mapTypeControl: false, streetViewControl: false, fullscreenControl: false,
                        styles: isDark() ? darkStyle() : []
                    });

                    const applyStyle = () => gmap.setOptions({ styles: isDark() ? darkStyle() : [] });
                    new MutationObserver(applyStyle).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
                    new MutationObserver(applyStyle).observe(document.body, { attributes: true, attributeFilter: ['class'] });

                    sharedInfoWin = new InfoWindow();
                    window.__closeSharedInfoWin = () => sharedInfoWin.close();
                    clearTimeout(mapWatchdog);
                    document.getElementById('dash-map-loading')?.classList.add('gone');
                    allBounds = new google.maps.LatLngBounds();
                    hasBounds = false;

                    GEO_FENCES.forEach(g => {
                        if (!g.Latitude || !g.Longitude) return;
                        const center = { lat: g.Latitude, lng: g.Longitude };

                        // Colour + fill strength come from the zone's GROUP (derived from its name).
                        const typeDef = zoneStyle(g.Name);   // .group, .stroke, .fillOp
                        const clr = { stroke: typeDef.stroke, fill: hexToRgba(typeDef.stroke, typeDef.fillOp) };

                        const pts = pkByLoc[g.Id] || [];          // already sorted by table Id
                        const devHere = devicesByGeo[g.Id] || [];
                        const photo = imgPath(g.Name);

                        const zoneBounds = new google.maps.LatLngBounds();
                        let pathLengthM = 0;
                        let zoneShape = null;
                        const zoneParkingMarkers = [];

                        const ordered = zoneBoundaryPts[g.Id];    // table order, or null

                        const openInfo = () => showParkInfo(g, pts, clr, devicesByGeo[g.Id] || [], pathLengthM);

                        if (ordered) {
                            // Points exactly in table sequence; the polygon closes
                            // from the last point back to the first.
                            const loopPath = ordered.map(p => ({ lat: p.Latitude, lng: p.Longitude }));
                            zoneShape = new google.maps.Polygon({
                                map: gmap, paths: loopPath, geodesic: true, clickable: true,
                                strokeColor: clr.stroke, strokeOpacity: .9, strokeWeight: LINE_WEIGHT,
                                fillColor: clr.stroke, fillOpacity: typeDef.fillOp
                            });
                            pathLengthM = loopDistanceKm(ordered) * 1000;
                        } else {
                            // Fewer than 3 points → circle of the registered radius
                            // (same boundary used for the containment test).
                            const radiusM = Math.max(g.RadiusMeters || 0, 30);
                            zoneShape = new google.maps.Circle({
                                map: gmap, center, radius: radiusM, clickable: true,
                                strokeColor: clr.stroke, strokeOpacity: .9, strokeWeight: LINE_WEIGHT,
                                fillColor: clr.stroke, fillOpacity: typeDef.fillOp
                            });
                            const circleBounds = zoneShape.getBounds();
                            if (circleBounds) { zoneBounds.union(circleBounds); allBounds.union(circleBounds); hasBounds = true; }
                        }

                        // Hover the area → name · type · live vehicle count. Click → info card.
                        zoneShape.addListener('mouseover', e => showGeoTooltip(g.Name, (devicesByGeo[g.Id] || []).length, e.domEvent));
                        zoneShape.addListener('mousemove', e => positionGeoTooltip(e.domEvent));
                        zoneShape.addListener('mouseout', () => hideGeoTooltip());
                        zoneShape.addListener('click', openInfo);

                        // No vertex dots are drawn — only the boundary line/area.
                        // The recorded points are still used to frame the camera.
                        pts.forEach(p => {
                            const pos = { lat: p.Latitude, lng: p.Longitude };
                            zoneBounds.extend(pos); allBounds.extend(pos); hasBounds = true;
                        });

                        // The zone's centre dot is no longer drawn. Only a zone with
                        // no recorded points uses its centre, for camera fitting.
                        if (!pts.length) { zoneBounds.extend(center); allBounds.extend(center); hasBounds = true; }

                        devHere.forEach(device => createTruckMarker(device, g.Name, g.Id));

                        geoShapes[g.Id] = {
                            pts, geo: g, clr, type: typeDef.group, center, devices: devHere, photo, zoneBounds, pathLengthM,
                            boundary: zoneShape,
                            parkingMarkers: zoneParkingMarkers
                        };
                    });

                    // Devices inside no geofence are still drawn.
                    unassignedDevices.forEach(device => createTruckMarker(device, null, null));

                    if (hasBounds) gmap.fitBounds(allBounds, { padding: 60 });

                    paintSidebarBadges();
                    applyStatusFilterToMap();
                    applyGeoFilter();
                    markUpdated(true);
                }

                // ══════════════════════════════════════════════════════════════
                // Zone visibility — a zone shows only if it passes BOTH the
                // single-zone filter and the group filter. Trucks are untouched.
                // ══════════════════════════════════════════════════════════════
                function applyGeoFilter() {
                    Object.keys(geoShapes).forEach(gid => {
                        const s = geoShapes[gid];
                        const visible =
                            (activeGeoFilter === null || String(gid) === String(activeGeoFilter)) &&
                            (activeTypeFilter === null || s.type === activeTypeFilter);
                        // Polygon/Circle only respond to setMap(), not ".map = null".
                        if (s.boundary) s.boundary.setMap(visible ? gmap : null);
                        s.parkingMarkers.forEach(m => { m.map = visible ? gmap : null; });
                        if (!visible) hideGeoTooltip();
                    });
                }

                // ── Zoom to location (sidebar row click) ─────────────────────
                window.zoomToLocation = function (geoId) {
                    const s = geoShapes[geoId];
                    if (!s) return;

                    // If a different group filter was on, drop it so this zone can show.
                    if (activeTypeFilter !== null && s.type !== activeTypeFilter) {
                        activeTypeFilter = null;
                        document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('type-hidden'));
                        paintLegend();
                    }
                    activeGeoFilter = geoId;
                    lastSelectedGeoId = geoId;
                    applyGeoFilter();
                    updateShowAllBtn();

                    document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
                    const tab = document.querySelector(`.loc-tab[data-geo-id="${geoId}"]`);
                    if (tab) tab.classList.add('active');

                    if (s.zoneBounds && !s.zoneBounds.isEmpty())
                        gmap.fitBounds(s.zoneBounds, { padding: 90 });
                    else { gmap.panTo(s.center); gmap.setZoom(17); }

                    showParkInfo(s.geo, s.pts, s.clr, devicesByGeo[geoId] || [], s.pathLengthM);
                };

                // ── IMEI table click → focus zone ────────────────────────────
                window.focusDeviceOnMap = function (imei, geoFenceId) {
                    document.getElementById('dash-map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => zoomToLocation(geoFenceId), 300);
                };

                // ── Park info popup ───────────────────────────────────────────
                function showParkInfo(g, pts, clr, devices, pathLengthM) {
                    // "Latest entry" = newest recorded point by timestamp (not by sequence).
                    const latest = pts.length
                        ? pts.reduce((a, b) => (a.CreatedAt >= b.CreatedAt ? a : b))
                        : null;
                    const photo = imgPath(g.Name);

                    const imgEl = document.getElementById('pi-img');
                    const placeholderEl = document.getElementById('pi-img-placeholder');
                    const titleEl = document.getElementById('pi-img-title');
                    const expandBtn = document.getElementById('pi-img-expand');

                    titleEl.textContent = g.Name + ' · ' + zoneTypeLabel(g.Name);

                    if (photo) {
                        imgEl.src = photo;
                        imgEl.style.display = 'block';
                        placeholderEl.style.display = 'none';
                        expandBtn.style.display = 'flex';
                    } else {
                        imgEl.style.display = 'none';
                        placeholderEl.style.display = 'flex';
                        expandBtn.style.display = 'none';
                    }

                    document.getElementById('pi-geo').textContent = g.RadiusMeters + ' m';
                    document.getElementById('pi-cnt').textContent = pts.length;
                    document.getElementById('pi-path').textContent = pts.length >= 3 ? Math.round(pathLengthM || 0) + ' m' : '—';
                    document.getElementById('pi-last').textContent = latest ? latest.CreatedAt : 'None';
                    document.getElementById('pi-devcnt').textContent = devices ? devices.length : 0;

                    if (pts.length >= 2) {
                        const lats = pts.map(p => p.Latitude);
                        const lngs = pts.map(p => p.Longitude);
                        const dlat = (Math.max(...lats) - Math.min(...lats)) * 111000;
                        const dlng = (Math.max(...lngs) - Math.min(...lngs)) * 111000 * Math.cos(lats[0] * Math.PI / 180);
                        document.getElementById('pi-area').textContent = Math.round(dlat) + ' × ' + Math.round(dlng) + ' m';
                    } else {
                        document.getElementById('pi-area').textContent = '—';
                    }

                    const vRow = document.getElementById('pi-vehicle-row');
                    const vInfo = document.getElementById('pi-vehicle-info');
                    if (devices && devices.length) {
                        vInfo.innerHTML = devices.map(d => {
                            const on = d.Status === 'online';
                            const c = deviceColor(d.Imei);
                            return `<span style="display:inline-flex;align-items:center;gap:5px">
                                                <span style="width:9px;height:9px;border-radius:50%;background:${c};flex-shrink:0"></span>
                                                🚛 <b>${esc(d.Imei)}</b>
                                                <span style="color:${on ? '#059669' : '#dc2626'};font-weight:700;font-size:10px">${on ? '●' : '○'}</span>
                                            </span>`;
                        }).join('');
                        vRow.style.display = 'flex';
                    } else {
                        vInfo.textContent = 'No devices currently in this zone';
                        vRow.style.display = 'flex';
                    }

                    document.getElementById('park-info').classList.add('show');
                }

                // ══════════════════════════════════════════════════════════════
                // STATUS FILTER (All / Online / Offline) — driven by the stat cards
                // ══════════════════════════════════════════════════════════════
                let statusFilter = 'all';

                window.setStatusFilter = function (f) {
                    statusFilter = f;
                    document.querySelectorAll('.dash-card.filterable').forEach(c => c.classList.toggle('filter-active', c.dataset.filter === f));
                    applyStatusFilterToTable();
                    applyStatusFilterToMap();
                };

                document.querySelectorAll('.dash-card.filterable').forEach(card => {
                    card.addEventListener('click', () => setStatusFilter(card.dataset.filter));
                });

                function applyStatusFilterToTable() {
                    const rows = document.querySelectorAll('#device-tbody tr[data-status]');
                    let visible = 0;
                    rows.forEach(r => {
                        const match = statusFilter === 'all' || r.dataset.status === statusFilter;
                        r.classList.toggle('row-hidden', !match);
                        if (match) visible++;
                    });
                    const countLbl = document.getElementById('tbl-head-count');
                    if (countLbl) countLbl.textContent = rows.length ? `Showing ${visible} of ${rows.length}` : '';
                    const emptyState = document.getElementById('tbl-filter-empty');
                    if (emptyState) emptyState.style.display = (rows.length > 0 && visible === 0) ? 'block' : 'none';
                }

                function applyStatusFilterToMap() {
                    Object.values(deviceMarkers).forEach(rec => {
                        const status = rec.iconEl.classList.contains('offline-vehicle') ? 'offline' : 'online';
                        const match = statusFilter === 'all' || status === statusFilter;
                        rec.marker.map = match ? gmap : null;
                    });
                }
                applyStatusFilterToTable();

                // ══════════════════════════════════════════════════════════════
                // LIVE REFRESH
                // ══════════════════════════════════════════════════════════════
                let refreshing = false;

                function markUpdated(ok) {
                    const wrap = document.getElementById('map-last-updated');
                    const txt = document.getElementById('map-last-updated-text');
                    if (!wrap || !txt) return;
                    wrap.classList.toggle('stale', !ok);
                    txt.textContent = ok ? ('Updated ' + new Date().toLocaleTimeString()) : 'Update failed — will retry';
                }

                async function refreshDevices() {
                    if (refreshing) return;
                    refreshing = true;
                    const btn = document.getElementById('btn-refresh');
                    if (btn) { btn.classList.add('spinning'); btn.disabled = true; }

                    try {
                        const res = await fetch('/Home/DashboardMapJson?_=' + Date.now(), { cache: 'no-store', headers: { 'Cache-Control': 'no-cache' } });
                        const d = await res.json();
                        if (!d.ok) throw new Error(d.error || 'Refresh failed');

                        DEVICES = d.devices || [];
                        const grouping = computeDevicesByGeo(DEVICES);
                        devicesByGeo = grouping.byGeo;
                        unassignedDevices = grouping.unassigned;

                        const imeiToZone = {};
                        Object.keys(devicesByGeo).forEach(gid => {
                            devicesByGeo[gid].forEach(d2 => { imeiToZone[d2.Imei] = gid; });
                        });

                        let onlineCount = 0;
                        DEVICES.forEach(dev => {
                            if (dev.Status === 'online') onlineCount++;

                            let rec = deviceMarkers[dev.Imei];
                            if (!rec && dev.Latitude && dev.Longitude) {
                                const gid = imeiToZone[dev.Imei];
                                const zoneName = gid && geoShapes[gid] ? geoShapes[gid].geo.Name : null;
                                createTruckMarker(dev, zoneName, gid || null);
                                rec = deviceMarkers[dev.Imei];
                            }
                            if (rec) {
                                rec.marker.position = { lat: dev.Latitude, lng: dev.Longitude };
                                const online = dev.Status === 'online';
                                rec.iconEl.classList.toggle('offline-vehicle', !online);
                                rec.labelEl.classList.toggle('offline-label', !online);
                            }

                            const row = document.getElementById('devrow-' + dev.Imei);
                            if (row) {
                                row.dataset.status = dev.Status;
                                const badgeCell = document.getElementById('devbadge-' + dev.Imei);
                                if (badgeCell) badgeCell.innerHTML = `<span class="badge badge-${dev.Status}">${dev.Status === 'online' ? '● Online' : '○ Offline'}</span>`;
                                const seenCell = document.getElementById('devseen-' + dev.Imei);
                                if (seenCell) seenCell.textContent = dev.LastSeen;
                                const locCell = document.getElementById('devloc-' + dev.Imei);
                                if (locCell) locCell.textContent = dev.Name || '—';
                            }
                        });

                        document.getElementById('stat-total').textContent = DEVICES.length;
                        document.getElementById('stat-online').textContent = onlineCount;
                        document.getElementById('stat-offline').textContent = DEVICES.length - onlineCount;

                        paintSidebarBadges();
                        applyStatusFilterToTable();
                        applyStatusFilterToMap();
                        markUpdated(true);
                    } catch (e) {
                        console.error('Device refresh failed:', e);
                        markUpdated(false);
                    } finally {
                        refreshing = false;
                        if (btn) { btn.classList.remove('spinning'); btn.disabled = false; }
                    }
                }

                document.getElementById('btn-refresh')?.addEventListener('click', refreshDevices);
                setInterval(refreshDevices, 30000);

                // ══════════════════════════════════════════════════════════════
                // Styling helper
                // ══════════════════════════════════════════════════════════════
                function darkStyle() {
                    return [
                        { elementType: 'geometry', stylers: [{ color: '#0f1117' }] },
                        { elementType: 'labels.text.stroke', stylers: [{ color: '#0f1117' }] },
                        { elementType: 'labels.text.fill', stylers: [{ color: '#4e5568' }] },
                        { featureType: 'administrative.locality', elementType: 'labels.text.fill', stylers: [{ color: '#9aa3b0' }] },
                        { featureType: 'poi.park', elementType: 'geometry', stylers: [{ color: '#151c1e' }] },
                        { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#1e2330' }] },
                        { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#243044' }] },
                        { featureType: 'road.highway', elementType: 'labels.text.fill', stylers: [{ color: '#f3d19c' }] },
                        { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#070c14' }] },
                    ];
                }

                window.initDashMap = initDashMap;

            } catch (err) {
                clearTimeout(mapWatchdog);
                console.error('Dashboard init error:', err);
                showMapError('Dashboard failed to initialize.');
            }
        })();
    </script>

    @if (!string.IsNullOrEmpty(mapsKey))
    {
        <text>
            <script src="https://maps.googleapis.com/maps/api/js?key=@mapsKey&callback=initDashMap&libraries=marker&loading=async" async defer></script>
        </text>
    }
}
