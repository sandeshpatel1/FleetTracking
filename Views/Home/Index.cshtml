@model TrackingMVC.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mapsKey = ViewBag.MapsKey as string ?? "";
    var geoJson = System.Text.Json.JsonSerializer.Serialize(Model?.GeoFences ?? new());
    var parkJson = System.Text.Json.JsonSerializer.Serialize(Model?.ParkingPoints ?? new());
    var devJson = System.Text.Json.JsonSerializer.Serialize(Model?.Devices ?? new());
}

@section Styles {
    <style>
        /* ── stat cards ─────────────────────────────────────────────── */
        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .dash-card {
            background: var(--card-bg,#fff);
            border: 1px solid var(--card-border,#eee);
            border-radius: 10px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
            transition: box-shadow .2s, border-color .2s, transform .1s;
            cursor: pointer;
            position: relative;
        }

            .dash-card:hover {
                box-shadow: 0 4px 14px rgba(0,0,0,.1);
            }

            .dash-card:active {
                transform: scale(.98);
            }

            .dash-card.filterable::after {
                content: 'Click to filter';
                position: absolute;
                bottom: 6px;
                right: 10px;
                font-size: 9px;
                color: #bbb;
                opacity: 0;
                transition: opacity .15s;
            }

            .dash-card.filterable:hover::after {
                opacity: 1;
            }

            .dash-card.filter-active {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,.14);
            }

        .card-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ci-total {
            background: rgba(99,102,241,.12);
        }

        .ci-online {
            background: rgba(16,185,129,.12);
        }

        .ci-offline {
            background: rgba(239,68,68,.12);
        }

        .ci-park {
            background: rgba(245,158,11,.12);
        }

        .card-val {
            font-size: 26px;
            font-weight: 700;
            line-height: 1;
        }

        .cv-total {
            color: #6366f1;
        }

        .cv-online {
            color: #10b981;
        }

        .cv-offline {
            color: #ef4444;
        }

        .cv-park {
            color: #f59e0b;
        }

        .card-lbl {
            font-size: 12px;
            color: #888;
            margin-top: 3px;
        }

        /* ── map section ─────────────────────────────────────────────── */
        .map-section {
            background: var(--card-bg,#fff);
            border: 1px solid var(--card-border,#eee);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
            margin-bottom: 20px;
        }

        .map-sec-head {
            padding: 13px 18px;
            border-bottom: 1px solid var(--card-border,#eee);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .map-sec-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .map-sec-sub {
            font-size: 11px;
            color: #888;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        #map-last-updated {
            font-size: 10.5px;
            color: #9aa0aa;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            #map-last-updated .lu-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #10b981;
                flex-shrink: 0;
            }

            #map-last-updated.stale .lu-dot {
                background: #f59e0b;
            }

        .map-legend {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .map-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .map-action-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--card-border,#eee);
            background: var(--card-bg,#fff);
            font-size: 11px;
            font-weight: 700;
            color: #555;
            cursor: pointer;
            white-space: nowrap;
            transition: background .15s, box-shadow .15s, transform 100ms ease-out;
        }

            .map-action-btn:hover {
                background: rgba(0,0,0,.04);
                box-shadow: 0 2px 8px rgba(0,0,0,.08);
            }

            .map-action-btn:active {
                transform: scale(.95);
            }

            .map-action-btn.accent {
                color: #2563eb;
                border-color: rgba(37,99,235,.3);
                background: rgba(37,99,235,.06);
            }

            .map-action-btn:disabled {
                opacity: .55;
                cursor: wait;
            }

            .map-action-btn .ra-icon {
                display: inline-block;
                transition: transform .2s linear;
            }

            .map-action-btn.spinning .ra-icon {
                animation: raSpin .8s linear infinite;
            }

        @@keyframes raSpin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── status filter chips (kept for reference / re-use elsewhere) ── */
        .status-filters {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 20px;
            border: 1px solid var(--card-border,#eee);
            background: var(--card-bg,#fff);
            font-size: 11px;
            font-weight: 700;
            color: #666;
            cursor: pointer;
            transition: background .15s, color .15s, border-color .15s;
        }

            .status-chip .sc-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
            }

            .status-chip[data-filter="all"] .sc-dot {
                background: #6366f1;
            }

            .status-chip[data-filter="online"] .sc-dot {
                background: #10b981;
            }

            .status-chip[data-filter="offline"] .sc-dot {
                background: #ef4444;
            }

            .status-chip.active {
                background: rgba(99,102,241,.1);
                border-color: #6366f1;
                color: #4338ca;
            }

        /* Fullscreen mode — the map & sidebar simply grow to fill the
                   viewport; the header (with the Exit button) stays visible so
                   there's always an obvious, on-screen way out, not just Esc. */
        .map-section:fullscreen,
        .map-section:-webkit-full-screen {
            background: var(--card-bg,#fff);
            display: flex;
            flex-direction: column;
        }

            .map-section:fullscreen .map-body,
            .map-section:-webkit-full-screen .map-body {
                flex: 1;
                min-height: 0;
            }

            .map-section:fullscreen #dash-map,
            .map-section:-webkit-full-screen #dash-map {
                height: 100%;
            }

            .map-section:fullscreen .loc-sidebar,
            .map-section:-webkit-full-screen .loc-sidebar {
                max-height: none;
            }

        /* ── sidebar search ─────────────────────────────────────────── */
        .loc-search-wrap {
            padding: 8px 12px;
            border-bottom: 1px solid #f0f0f0;
            position: sticky;
            top: 34px;
            background: var(--card-bg,#fff);
            z-index: 2;
        }

        #loc-search {
            width: 100%;
            box-sizing: border-box;
            padding: 7px 10px;
            border-radius: 8px;
            border: 1px solid var(--card-border,#eee);
            font-size: 12px;
            outline: none;
            transition: border-color .15s;
        }

            #loc-search:focus {
                border-color: #6366f1;
            }

        .loc-empty-filtered {
            padding: 18px 14px;
            font-size: 11.5px;
            color: #aaa;
            text-align: center;
        }

        /* ── map loading spinner ────────────────────────────────────── */
        #dash-map-loading {
            position: absolute;
            inset: 0;
            background: var(--card-bg,#fff);
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: center;
            justify-content: center;
            z-index: 25;
            transition: opacity .25s ease;
        }

            #dash-map-loading.gone {
                opacity: 0;
                pointer-events: none;
            }

        .dm-ring {
            width: 34px;
            height: 34px;
            border: 3px solid rgba(0,0,0,.08);
            border-top-color: #6366f1;
            border-radius: 50%;
            animation: dmspin .8s linear infinite;
        }

        @@keyframes dmspin {
            to {
                transform: rotate(360deg);
            }
        }

        .dm-txt {
            font-size: 11px;
            color: #999;
            letter-spacing: .04em;
        }

        .leg-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: #666;
        }

        .leg-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .leg-poly {
            width: 16px;
            height: 0;
            border-top: 2.5px dashed #2563eb;
        }

        /* ── zone TYPE legend (doubles as a type filter) ─────────────── */
        .leg-type {
            cursor: pointer;
            padding: 3px 9px;
            border-radius: 14px;
            border: 1px solid transparent;
            user-select: none;
            font-weight: 600;
            transition: background .12s, border-color .12s;
        }

            .leg-type:hover {
                background: rgba(0,0,0,.05);
            }

            .leg-type.active {
                border-color: currentColor;
                background: rgba(0,0,0,.06);
                font-weight: 700;
            }

        /* sidebar tab: coloured left stripe + type badge */
        .loc-tab {
            box-shadow: inset 4px 0 0 var(--zt, transparent);
        }

            .loc-tab.type-hidden {
                display: none;
            }

        .zt-badge {
            display: inline-block;
            font-size: 9px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 8px;
            color: #fff;
            margin-left: 5px;
            vertical-align: middle;
        }

        #dash-map {
            width: 100%;
            height: 530px;
        }

        .map-body {
            display: flex;
            position: relative;
        }

        /* ── COLLAPSIBLE sidebar ─────────────────────────────────────── */
        .loc-sidebar {
            width: 248px;
            flex-shrink: 0;
            border-right: 1px solid var(--card-border,#eee);
            overflow-y: auto;
            max-height: 530px;
            background: var(--card-bg,#fff);
            transition: width .25s ease, opacity .2s ease;
            position: relative;
            z-index: 5;
        }

            .loc-sidebar.collapsed {
                width: 0;
                opacity: 0;
                overflow: hidden;
                border-right: none;
            }

            .loc-sidebar::-webkit-scrollbar {
                width: 3px;
            }

            .loc-sidebar::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.1);
                border-radius: 2px;
            }

        .locsidebar-header {
            padding: 10px 14px;
            font-size: 10px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: .08em;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: var(--card-bg,#fff);
            z-index: 2;
        }

        .sidebar-toggle-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #aaa;
            font-size: 14px;
            padding: 0;
            transition: color .15s;
        }

            .sidebar-toggle-btn:hover {
                color: #555;
            }

        .sidebar-open-btn {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 20;
            background: #fff;
            border: 1px solid rgba(0,0,0,.12);
            border-radius: 8px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 700;
            color: #555;
            cursor: pointer;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
            display: none;
            align-items: center;
            gap: 6px;
            transition: box-shadow .15s;
        }

            .sidebar-open-btn:hover {
                box-shadow: 0 4px 16px rgba(0,0,0,.18);
            }

            .sidebar-open-btn.visible {
                display: flex;
            }

        /* ── sidebar location tab ────────────────────────────────────── */
        .loc-tab {
            cursor: pointer;
            transition: background .12s;
            border-bottom: 1px solid var(--card-border,#eee);
        }

            .loc-tab:last-child {
                border-bottom: none;
            }

            .loc-tab:hover {
                background: rgba(0,0,0,.025);
            }

            .loc-tab.active {
                background: rgba(99,102,241,.06);
                border-left: 3px solid #6366f1;
            }

        .loc-tab-thumb {
            width: 100%;
            height: 72px;
            object-fit: cover;
            display: block;
            background: #f3f4f6;
            border-bottom: 1px solid #f0f0f0;
        }

        .loc-tab-thumb-placeholder {
            width: 100%;
            height: 72px;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #9ca3af;
            border-bottom: 1px solid #f0f0f0;
        }

        .loc-tab-row {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
        }

        .loc-tab-icon {
            font-size: 15px;
            flex-shrink: 0;
        }

        .loc-tab-body {
            flex: 1;
            min-width: 0;
        }

        .loc-tab-name {
            font-size: 11.5px;
            font-weight: 600;
            color: #111;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .loc-tab-sub {
            font-size: 10px;
            color: #888;
            margin-top: 1px;
        }

        .dev-count-badge {
            background: rgba(37,99,235,.12);
            color: #2563eb;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 10px;
            flex-shrink: 0;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            transition: background .2s, color .2s;
        }

        /* ── map area ────────────────────────────────────────────────── */
        .map-area {
            flex: 1;
            position: relative;
            min-width: 0;
        }

        /* ── Google Maps InfoWindow — compact, Apple-style card ──────────
                   Google's default chrome reserves generous padding + room for the
                   close button regardless of content, which is what makes a short
                   popup (e.g. just a zone name + a count) look mostly empty space.
                   These overrides strip that down to a tight card: no default
                   padding (the content div supplies its own), no pointer tail
                   (a floating card reads cleaner than an arrow here), a small
                   close affordance, and a soft shadow instead of the flat default. */
        .gm-style .gm-style-iw-c {
            padding: 0 !important;
            border-radius: 14px !important;
            box-shadow: 0 10px 28px rgba(0,0,0,.16), 0 1px 3px rgba(0,0,0,.08) !important;
            max-width: 240px !important;
        }

        .gm-style .gm-style-iw-d {
            overflow: hidden !important;
            max-height: none !important;
        }

        .gm-style .gm-style-iw-tail {
            display: none !important;
        }

        /* The default close button lives in Google's own internal chrome
                   row, whose size/position is recalculated by their JS using the
                   card's ORIGINAL (larger) dimensions — CSS overrides on that row
                   fight that calculation and land the button in the wrong place.
                   Simplest reliable fix: hide Google's chrome entirely and draw
                   our own close control inside the popup's own HTML instead,
                   where plain CSS positions it correctly every time. */
        .gm-style .gm-style-iw-chr {
            display: none !important;
        }

        /* ── Geofence hover tooltip — shows the zone/parking-location name
                   only while the cursor is over the geofenced boundary area (or its
                   small marker dot). Nothing is drawn permanently on the map. ── */
        .geo-name-tooltip {
            position: absolute;
            pointer-events: none;
            background: rgba(15,20,30,.92);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 11px;
            border-radius: 7px;
            white-space: nowrap;
            z-index: 30;
            display: none;
            box-shadow: 0 6px 18px rgba(0,0,0,.28);
            font-family: 'Segoe UI', sans-serif;
        }

            .geo-name-tooltip.show {
                display: block;
            }

        /* ── park info popup (bottom-right) ─────────────────────────── */
        #park-info {
            position: absolute;
            bottom: 14px;
            right: 14px;
            background: rgba(255,255,255,.98);
            border: 1px solid rgba(0,0,0,.08);
            border-radius: 14px;
            z-index: 10;
            display: none;
            width: 290px;
            box-shadow: 0 8px 32px rgba(0,0,0,.18);
            font-size: 12px;
            overflow: hidden;
        }

            #park-info.show {
                display: block;
            }

        .pi-img-wrap {
            position: relative;
            width: 100%;
            height: 140px;
            background: #f3f4f6;
            overflow: hidden;
            cursor: zoom-in;
        }

            .pi-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .pi-img-placeholder {
            width: 100%;
            height: 140px;
            background: linear-gradient(135deg,#e0e7ef,#c7d2e0);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
        }

        .pi-img-gradient {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: linear-gradient(to top, rgba(0,0,0,.55), transparent);
            pointer-events: none;
        }

        .pi-img-title {
            position: absolute;
            bottom: 8px;
            left: 10px;
            right: 40px;
            color: #fff;
            font-weight: 700;
            font-size: 12.5px;
            text-shadow: 0 1px 4px rgba(0,0,0,.6);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            pointer-events: none;
        }

        .pi-img-close {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0,0,0,.45);
            border: none;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
            z-index: 2;
        }

            .pi-img-close:hover {
                background: rgba(0,0,0,.7);
            }

        .pi-img-expand {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,.5);
            border: none;
            border-radius: 7px;
            width: 28px;
            height: 28px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s, transform .15s;
            z-index: 2;
        }

            .pi-img-expand:hover {
                background: rgba(0,0,0,.75);
                transform: scale(1.08);
            }

        .pi-body {
            padding: 12px 14px 10px;
        }

        .pi-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #666;
            margin-bottom: 5px;
            font-size: 11px;
        }

            .pi-row:last-child {
                margin-bottom: 0;
            }

        .pi-val {
            font-weight: 600;
            color: #111;
            font-family: 'Courier New', monospace;
            font-size: 11px;
        }

        .pi-vehicle-row {
            background: rgba(37,99,235,.06);
            border: 1px solid rgba(37,99,235,.15);
            border-radius: 8px;
            padding: 7px 10px;
            margin-top: 8px;
            font-size: 11px;
            color: #1e40af;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px 10px;
        }

        /* ── image lightbox ───────────────────────────────────────────── */
        #img-lightbox {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.85);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
            cursor: zoom-out;
        }

            #img-lightbox.show {
                display: flex;
            }

            #img-lightbox img {
                max-width: 100%;
                max-height: 100%;
                border-radius: 10px;
                box-shadow: 0 10px 50px rgba(0,0,0,.5);
                cursor: default;
            }

        .lightbox-caption {
            position: absolute;
            bottom: 24px;
            left: 0;
            right: 0;
            text-align: center;
            color: #ef4444;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: .03em;
            text-shadow: 0 1px 3px rgba(0,0,0,.85), 0 0 18px rgba(0,0,0,.55);
        }

        .lightbox-close {
            position: absolute;
            top: 18px;
            right: 24px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.3);
            border-radius: 50%;
            width: 38px;
            height: 38px;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

            .lightbox-close:hover {
                background: rgba(255,255,255,.25);
            }

        /* ── vehicle marker ──────────────────────────────────────────── */
        .vehicle-marker {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            filter: drop-shadow(0 3px 8px rgba(0,0,0,.3));
            transition: opacity .25s ease;
        }

        .vehicle-icon-wrap {
            border: 3px solid #fff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            animation: vehiclePulse 2.5s ease-in-out infinite;
        }

            .vehicle-icon-wrap.offline-vehicle {
                opacity: .55;
                animation: none;
            }

        .vehicle-label {
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 4px;
            margin-top: 3px;
            white-space: nowrap;
            box-shadow: 0 2px 6px rgba(0,0,0,.35);
        }

            .vehicle-label.offline-label {
                opacity: .6;
            }

        @@keyframes vehiclePulse {
            0%, 100% {
                filter: drop-shadow(0 0 0 rgba(0,0,0,0));
            }

            50% {
                filter: drop-shadow(0 0 6px currentColor);
            }
        }

        /* ── device table ────────────────────────────────────────────── */
        .tbl-section {
            background: var(--card-bg,#fff);
            border: 1px solid var(--card-border,#eee);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
        }

        .tbl-head {
            padding: 13px 18px;
            border-bottom: 1px solid var(--card-border,#eee);
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .tbl-head-count {
            font-size: 11px;
            font-weight: 600;
            color: #999;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            padding: 9px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            color: #888;
            text-transform: uppercase;
            letter-spacing: .06em;
            border-bottom: 1px solid var(--card-border,#eee);
        }

        td {
            padding: 10px 16px;
            font-size: 13px;
            border-bottom: 1px solid var(--row-border,#f5f5f5);
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: var(--row-hover,#fafafa);
        }

        tr.row-hidden {
            display: none;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-online {
            background: rgba(16,185,129,.1);
            color: #059669;
        }

        .badge-offline {
            background: rgba(239,68,68,.1);
            color: #dc2626;
        }

        .imei-link {
            font-family: 'Space Mono','Courier New',monospace;
            font-size: 11px;
            color: #2563eb;
            cursor: pointer;
            text-decoration: underline dotted;
        }

            .imei-link:hover {
                color: #1d4ed8;
            }

        .tbl-empty-state {
            text-align: center;
            padding: 34px 20px;
            color: #aaa;
        }

            .tbl-empty-state .tes-icon {
                font-size: 26px;
                display: block;
                margin-bottom: 8px;
                opacity: .5;
            }

            .tbl-empty-state button {
                margin-top: 10px;
                border: 1px solid #6366f1;
                color: #6366f1;
                background: rgba(99,102,241,.06);
                padding: 5px 14px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
            }

                .tbl-empty-state button:hover {
                    background: rgba(99,102,241,.12);
                }
    </style>
}

<div class="page-wrapper">

    <!-- ── stat cards (double as status filters — click to filter table & map) ── -->
    <div class="dash-grid">
        <div class="dash-card filterable" id="card-total" data-filter="all">
            <div class="card-icon ci-total">📡</div>
            <div><div class="card-val cv-total" id="stat-total">@(Model?.TotalDevices ?? 0)</div><div class="card-lbl">Total Devices</div></div>
        </div>
        <div class="dash-card filterable" id="card-online" data-filter="online">
            <div class="card-icon ci-online">🟢</div>
            <div><div class="card-val cv-online" id="stat-online">@(Model?.OnlineDevices ?? 0)</div><div class="card-lbl">Online Now</div></div>
        </div>
        <div class="dash-card filterable" id="card-offline" data-filter="offline">
            <div class="card-icon ci-offline">🔴</div>
            <div><div class="card-val cv-offline" id="stat-offline">@(Model?.OfflineDevices ?? 0)</div><div class="card-lbl">Offline</div></div>
        </div>
        <div class="dash-card" id="card-zones" style="cursor:default">
            <div class="card-icon ci-park">🅿</div>
            <div><div class="card-val cv-park">@(Model?.GeoFences?.Count ?? 0)</div><div class="card-lbl">Parking Zones</div></div>
        </div>
    </div>

    <!-- ── map section ── -->
    <div class="map-section">
        <div class="map-sec-head">
            <div>
                <div class="map-sec-title">🗺 Fleet &amp; Parking Zones</div>
                <div class="map-sec-sub">
                    <span>Hover a zone to see its name &amp; </span>
                    <span id="map-last-updated"><span class="lu-dot"></span><span id="map-last-updated-text">Loading…</span></span>
                </div>
            </div>

            <!-- zone TYPE legend — click a type to filter the map + sidebar -->
            <div class="map-legend" id="zone-legend"></div>

            <div class="map-actions">
                <button class="map-action-btn" id="btn-refresh" title="Refresh live device positions now">
                    <span class="ra-icon">⟳</span> Refresh
                </button>
                <button class="map-action-btn" id="btn-fit-all" title="Fit all zones in view">⤢ Fit All</button>
                <button class="map-action-btn" id="btn-show-all" title="Show all zones again">↺ Show All</button>
                <button class="map-action-btn accent" id="btn-fullscreen" title="View map full screen">⛶ Full Screen</button>
            </div>
        </div>

        <div class="map-body">

            <!-- ── collapsible location sidebar ── -->
            <div class="loc-sidebar" id="loc-sidebar">
                <div class="locsidebar-header">
                    <span>Locations</span>
                    <button class="sidebar-toggle-btn" title="Collapse" onclick="toggleSidebar()">◀</button>
                </div>
                <div class="loc-search-wrap">
                    <input type="text" id="loc-search" placeholder="🔍 Search locations…" />
                </div>

                @if (Model?.GeoFences?.Any() == true)
                {
                    foreach (var g in Model.GeoFences)
                    {
                        var pkCount = Model.ParkingPoints?.Count(p => p.ParkingLocationId == g.Id) ?? 0;
                        // Image filename is expected to match the geofence name exactly:
                        // e.g. name "DN18 (CRM FINISHING)" → file "/assest/DN18 (CRM FINISHING).jpeg"
                        var imgPath = string.IsNullOrWhiteSpace(g.Name)
                        ? null
                        : $"/assest/{Uri.EscapeDataString(g.Name)}.jpeg";

                        <div class="loc-tab" data-geo-id="@g.Id" onclick="zoomToLocation(@g.Id)">
                            @if (imgPath != null)
                            {
                                <img class="loc-tab-thumb"
                                     src="@imgPath"
                                     alt="@g.Name"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            }
                            <div class="loc-tab-thumb-placeholder" style="display:@(imgPath != null ? "none" : "flex");">🅿</div>

                            <div class="loc-tab-row">
                                <div class="loc-tab-icon">@(pkCount > 0 ? "🅿" : "📍")</div>
                                <div class="loc-tab-body">
                                    <div class="loc-tab-name">@g.Name</div>
                                    <div class="loc-tab-sub">r = @g.RadiusMeters m</div>
                                </div>
                                <span class="dev-count-badge" id="devcnt-@g.Id" style="display:none">0 🚛</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding:20px;font-size:12px;color:#aaa;text-align:center">No locations</div>
                }
                <div class="loc-empty-filtered" id="loc-empty-filtered" style="display:none">No locations match your search</div>
            </div>

            <!-- floating re-open button -->
            <button class="sidebar-open-btn" id="sidebar-open-btn" onclick="toggleSidebar()">
                ▶ <span style="font-size:11px">Locations</span>
            </button>

            <!-- map canvas -->
            <div class="map-area">
                <div id="dash-map"></div>
                <div id="dash-map-loading">
                    <div class="dm-ring"></div>
                    <div class="dm-txt">LOADING MAP…</div>
                </div>

                <!-- ── geofence hover tooltip (shows the zone's name only on hover) ── -->
                <div id="geo-name-tooltip" class="geo-name-tooltip"></div>

                <!-- ── park info popup ── -->
                <div id="park-info">
                    <div class="pi-img-wrap" id="pi-img-wrap" onclick="openLightbox()">
                        <div class="pi-img-placeholder" id="pi-img-placeholder">🅿</div>
                        <img id="pi-img" src="" alt="" style="display:none;"
                             onerror="document.getElementById('pi-img').style.display='none';document.getElementById('pi-img-placeholder').style.display='flex';document.getElementById('pi-img-expand').style.display='none';" />
                        <div class="pi-img-gradient"></div>
                        <div class="pi-img-title" id="pi-img-title">—</div>
                        <button class="pi-img-expand" id="pi-img-expand" title="View larger"
                                onclick="event.stopPropagation();openLightbox();">
                            🔍
                        </button>
                        <button class="pi-img-close"
                                onclick="event.stopPropagation();document.getElementById('park-info').classList.remove('show')">
                            ✕
                        </button>
                    </div>

                    <div class="pi-body">
                        <div class="pi-row">Geofence radius  <span class="pi-val" id="pi-geo">—</span></div>
                        <div class="pi-row">Recorded points  <span class="pi-val" id="pi-cnt">—</span></div>
                        <div class="pi-row">Zone path length <span class="pi-val" id="pi-path">—</span></div>
                        <div class="pi-row">Boundary area    <span class="pi-val" id="pi-area">—</span></div>
                        <div class="pi-row">Latest entry     <span class="pi-val" id="pi-last">—</span></div>
                        <div class="pi-row">Devices here     <span class="pi-val" id="pi-devcnt">—</span></div>
                        <div id="pi-vehicle-row" class="pi-vehicle-row" style="display:none">
                            <span id="pi-vehicle-info">—</span>
                        </div>
                    </div>
                </div>

                <!-- ── big image lightbox/preview ── -->
                <div id="img-lightbox" onclick="closeLightbox()">
                    <button class="lightbox-close" onclick="event.stopPropagation();closeLightbox()">✕</button>
                    <img id="lightbox-img" src="" alt="" onclick="event.stopPropagation()" />
                    <div class="lightbox-caption" id="lightbox-caption">—</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── device table ── -->
    <div class="tbl-section">
        <div class="tbl-head">
            <span>📋 Device List</span>
            <span class="tbl-head-count" id="tbl-head-count"></span>
        </div>
        <table>
            <thead>
                <tr><th>#</th><th>IMEI</th><th>Location</th><th>Status</th><th>Last Seen</th><th>Action</th></tr>
            </thead>
            <tbody id="device-tbody">
                @if (Model?.Devices?.Any() == true)
                {
                    int n = 0;
                    foreach (var d in Model.Devices)
