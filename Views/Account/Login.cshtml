@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login – TrackSystem</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *,*::before,*::after{box-sizing:border-box}
        body{margin:0;min-height:100vh;font-family:'Poppins',system-ui,sans-serif;
             background:linear-gradient(135deg,#060d1f 0%,#0f1f4a 50%,#061530 100%);
             display:flex;align-items:center;justify-content:center;padding:16px}
        .wrap{display:flex;width:860px;max-width:100%;border-radius:20px;overflow:hidden;
              box-shadow:0 32px 80px rgba(0,0,0,0.55)}
        /* ── Left brand panel ── */
        .brand-panel{flex:1;background:linear-gradient(150deg,#1e40af 0%,#1d4ed8 50%,#0369a1 100%);
                     padding:48px 40px;display:flex;flex-direction:column;justify-content:space-between;
                     position:relative;overflow:hidden}
        .brand-panel::before{content:'';position:absolute;top:-80px;right:-80px;width:320px;height:320px;
                             border-radius:50%;background:rgba(255,255,255,0.05)}
        .brand-panel::after{content:'';position:absolute;bottom:-100px;left:-50px;width:280px;height:280px;
                            border-radius:50%;background:rgba(255,255,255,0.04)}
        .bp-logo{display:flex;align-items:center;gap:14px;position:relative}
        .bp-icon{width:50px;height:50px;border-radius:13px;
                 background:rgba(255,255,255,0.15);backdrop-filter:blur(6px);
                 display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff}
        .bp-name{color:#fff;font-weight:800;font-size:22px;line-height:1}
        .bp-sub{color:rgba(255,255,255,0.6);font-size:12px;margin-top:3px}
        .bp-tagline{position:relative}
        .bp-tagline h2{color:#fff;font-size:28px;font-weight:700;margin:0 0 12px;line-height:1.3}
        .bp-tagline p{color:rgba(255,255,255,0.65);font-size:13px;line-height:1.75;margin:0}
        .bp-stats{display:flex;gap:28px;position:relative}
        .bps-item .num{color:#fff;font-weight:800;font-size:22px}
        .bps-item .lbl{color:rgba(255,255,255,0.5);font-size:11px;margin-top:2px}
        /* ── Right form panel ── */
        .form-panel{width:400px;background:#fff;padding:48px 40px;display:flex;flex-direction:column;justify-content:center}
        .fp-title{font-size:24px;font-weight:800;color:#0f172a;margin:0 0 4px}
        .fp-sub  {font-size:13px;color:#6b7280;margin:0 0 28px}
        .fgroup  {margin-bottom:18px}
        .flabel  {display:block;font-size:11px;font-weight:700;color:#374151;margin-bottom:6px;
                  text-transform:uppercase;letter-spacing:.5px}
        .fin-wrap{position:relative}
        .fin-wrap i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#9ca3af;font-size:14px}
        .finput  {width:100%;padding:11px 13px 11px 38px;border:1.5px solid #e5e7eb;border-radius:9px;
                  font-family:inherit;font-size:14px;color:#0f172a;transition:border .2s,box-shadow .2s;outline:none}
        .finput:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.12)}
        .frow    {display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
        .fcheck  {display:flex;align-items:center;gap:8px;font-size:13px;color:#6b7280;cursor:pointer}
        .fcheck input{accent-color:#2563eb;width:15px;height:15px}
        .btn-login{width:100%;padding:12px;background:linear-gradient(90deg,#00c6ff,#2563eb);
                   border:none;border-radius:9px;color:#fff;font-family:inherit;font-size:15px;
                   font-weight:700;cursor:pointer;box-shadow:0 6px 20px rgba(37,99,235,.35);
                   transition:transform .15s,box-shadow .15s}
        .btn-login:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(37,99,235,.45)}
        .btn-login:active{transform:none}
        .ferror{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;
                border-radius:9px;padding:11px 14px;font-size:13px;margin-bottom:18px;
                display:flex;gap:8px;align-items:center}
        @@media(max-width:620px){.brand-panel{display:none}.form-panel{width:100%}.wrap{border-radius:16px}}
    </style>
</head>
<body>
<div class="wrap">
    <div class="brand-panel">
        <div class="bp-logo">
            <div class="bp-icon"><i class="fa-solid fa-route"></i></div>
            <div>
                <div class="bp-name">TrackSystem</div>
                <div class="bp-sub">Fleet Management Platform</div>
            </div>
        </div>
        <div class="bp-tagline">
            <h2>Real-time vehicle tracking at your fingertips</h2>
            <p>Monitor your entire fleet from one dashboard. Live GPS, history playback, geo-fencing and intelligent alerts.</p>
        </div>
        <div class="bp-stats">
            <div class="bps-item"><div class="num">99.9%</div><div class="lbl">Uptime</div></div>
            <div class="bps-item"><div class="num">500ms</div><div class="lbl">Latency</div></div>
            <div class="bps-item"><div class="num">24/7</div><div class="lbl">Support</div></div>
        </div>
    </div>

    <div class="form-panel">
        <h2 class="fp-title">Welcome back</h2>
        <p class="fp-sub">Sign in to continue to your dashboard</p>

        @if (Model.Error != null)
        {
            <div class="ferror">
                <i class="fa-solid fa-circle-exclamation"></i>
                @Model.Error
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div class="fgroup">
                <label class="flabel">Username or Email</label>
                <div class="fin-wrap">
                    <i class="fa-solid fa-user"></i>
                    <input class="finput" type="text" name="Username"
                           value="@Model.Username" placeholder="Enter username or email"
                           autocomplete="username" required />
                </div>
            </div>
            <div class="fgroup">
                <label class="flabel">Password</label>
                <div class="fin-wrap">
                    <i class="fa-solid fa-lock"></i>
                    <input class="finput" type="password" name="Password"
                           placeholder="Enter your password" autocomplete="current-password" required />
                </div>
            </div>
            <div class="frow">
                <label class="fcheck">
                    <input type="checkbox" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                    Remember me
                </label>
            </div>
            <button type="submit" class="btn-login">
                <i class="fa-solid fa-right-to-bracket" style="margin-right:8px"></i>Sign In
            </button>
        </form>
    </div>
</div>
</body>
</html>
