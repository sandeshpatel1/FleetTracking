@{
    ViewBag.Title = "Live Tracking Map";







    Layout = "~/Views/Shared/_Layout.cshtml";







    var mapsKey = ViewBag.MapsKey as string ?? "";
}

@section Styles {
    <style>
        /* ── override layout so map fills content area ── */
        #main-wrap {
            padding: 0 !important;
            overflow: hidden;
        }

        #trackmap-root {
            position: relative;
            width: 100%;
            height: calc(100vh - 56px);
            overflow: hidden;
            font-family: 'DM Sans', 'Segoe UI', sans-serif;
        }

        #gmap {
            width: 100%;
            height: 100%;
        }

        /* ════════════════════════════════════════════
                               TRUCK MARKER  — the visible vehicle icon
                               This is the HTML element passed to
                               AdvancedMarkerElement as `content`.
                               ════════════════════════════════════════════ */
        .truck-marker-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            /* no overflow:hidden — the pulse must escape the container */
            position: relative;
        }

        /* pulsing GPS halo (online only) */
        .gps-halo {
            position: relative;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2px;
        }

            .gps-halo .ring {
                position: absolute;
                inset: 0;
                border-radius: 50%;
                background: rgba(0, 229, 160, 0.45);
                animation: gpsPing 1.9s ease-out infinite;
            }

            .gps-halo .ring2 {
                animation-delay: 0.65s;
            }

            .gps-halo .core {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #00e5a0;
                box-shadow: 0 0 7px #00e5a0;
                z-index: 1;
                flex-shrink: 0;
            }

        @@keyframes gpsPing {
            0% {
                transform: scale(0.3);
                opacity: 0.9;
            }

            100% {
                transform: scale(2.6);
                opacity: 0;
            }
        }

        /* offline: no pulse, grey dot */
        .truck-marker-wrap.offline .ring {
            display: none;
        }

        .truck-marker-wrap.offline .core {
            background: #6b7280;
            box-shadow: none;
        }

        /* The truck SVG container */
        .truck-svg-wrap {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            filter: drop-shadow(0 3px 8px rgba(0,0,0,0.55));
            transition: transform 0.2s;
        }

        .truck-marker-wrap:hover .truck-svg-wrap {
            transform: scale(1.15);
        }

        .truck-marker-wrap.offline .truck-svg-wrap {
            filter: grayscale(60%) drop-shadow(0 2px 5px rgba(0,0,0,0.4));
            opacity: 0.7;
        }

        /* name label below truck */
        .truck-label {
            margin-top: 3px;
            background: rgba(10,12,15,0.82);
            color: #e8eaf0;
            font-size: 9.5px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 4px;
            white-space: nowrap;
            letter-spacing: 0.03em;
            border: 1px solid rgba(255,255,255,0.08);
            backdrop-filter: blur(4px);
            max-width: 110px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .light-theme .truck-label {
            background: rgba(255,255,255,0.9);
            color: #111;
            border-color: rgba(0,0,0,0.1);
        }

        .truck-marker-wrap.offline .truck-label {
            color: #9ca3af;
        }

        /* ── HUD strip ── */
        #map-hud {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 48px;
            background: rgba(10,12,15,.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,.07);
            display: flex;
            align-items: center;
            padding: 0 14px;
            gap: 8px;
            z-index: 20;
        }

        .light-theme #map-hud {
            background: rgba(255,255,255,.9);
            border-bottom: 1px solid rgba(0,0,0,.1);
        }

        .hud-logo {
            font-family: 'Space Mono','Courier New',monospace;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .12em;
            color: #00e5a0;
            margin-right: 8px;
            white-space: nowrap;
        }

        .hud-sep {
            width: 1px;
            height: 24px;
            background: rgba(255,255,255,.1);
            margin: 0 6px;
            flex-shrink: 0;
        }

        .light-theme .hud-sep {
            background: rgba(0,0,0,.12);
        }

        .stat-chip {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 4px;
            background: rgba(255,255,255,.05);
            font-size: 11px;
            font-weight: 500;
            white-space: nowrap;
            color: #c0c4cc;
        }

        .light-theme .stat-chip {
            background: rgba(0,0,0,.05);
            color: #444;
        }

        .stat-chip strong {
            color: #e8eaf0;
        }

        .light-theme .stat-chip strong {
            color: #111;
        }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-g {
            background: #00e5a0;
            box-shadow: 0 0 5px #00e5a0;
        }

        .dot-r {
            background: #ff4b4b;
            box-shadow: 0 0 5px #ff4b4b;
        }

        .dot-b {
            background: #0af;
            box-shadow: 0 0 5px #0af;
        }

        .dot-y {
            background: #f59e0b;
            box-shadow: 0 0 5px #f59e0b;
        }

        .hud-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .btn-h {
            padding: 5px 11px;
            border-radius: 4px;
            font-size: 11px;
            font-family: 'Space Mono','Courier New',monospace;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.1);
            background: transparent;
            color: #c0c4cc;
            transition: background .15s, color .15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            letter-spacing: .04em;
            white-space: nowrap;
        }

            .btn-h:hover {
                background: rgba(255,255,255,.07);
                color: #00e5a0;
            }

            .btn-h.accent {
                border-color: #00e5a0;
                color: #00e5a0;
            }

                .btn-h.accent:hover {
                    background: rgba(0,229,160,.1);
                }

            .btn-h.active {
                background: rgba(0,229,160,.15);
            }

        .light-theme .btn-h {
            border-color: rgba(0,0,0,.15);
            color: #444;
        }

            .light-theme .btn-h:hover {
                background: rgba(0,0,0,.05);
                color: #00a070;
            }

            .light-theme .btn-h.accent {
                border-color: #00a070;
                color: #00a070;
            }

        #refresh-cd {
            font-family: 'Space Mono',monospace;
            font-size: 10px;
            color: #505560;
            white-space: nowrap;
        }

        .light-theme #refresh-cd {
            color: #888;
        }

        /* ── Zoom lock control ── */
        .zoom-lock-wrap {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: #c0c4cc;
            white-space: nowrap;
        }

        .light-theme .zoom-lock-wrap {
            color: #444;
        }

        #zoom-lock-select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.15);
            color: #e8eaf0;
            font-family: 'Space Mono','Courier New',monospace;
            font-size: 10.5px;
            font-weight: 700;
            border-radius: 4px;
            padding: 4px 6px;
            cursor: pointer;
            outline: none;
        }

        .light-theme #zoom-lock-select {
            background: rgba(0,0,0,.04);
            border-color: rgba(0,0,0,.18);
            color: #222;
        }

        #zoom-lock-select:focus {
            border-color: #00e5a0;
        }

        /* ── Device panel ── */
        #dev-panel {
            position: absolute;
            top: 62px;
            left: 12px;
            width: 268px;
            max-height: calc(100% - 80px);
            display: flex;
            flex-direction: column;
            background: rgba(10,12,15,.9);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 10px;
            z-index: 15;
            overflow: hidden;
            transition: transform .3s ease, background .2s ease;
        }

        .light-theme #dev-panel {
            background: rgba(255,255,255,.96);
            border-color: rgba(0,0,0,.1);
            box-shadow: 0 6px 24px rgba(0,0,0,.08);
        }

        #dev-panel.collapsed {
            transform: translateX(calc(-100% - 16px));
        }

        .p-head {
            padding: 10px 13px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .light-theme .p-head {
            border-bottom-color: rgba(0,0,0,.08);
        }

        .p-title {
            font-family: 'Space Mono',monospace;
            font-size: 10px;
            letter-spacing: .1em;
            color: #00e5a0;
            text-transform: uppercase;
        }

        .light-theme .p-title {
            color: #00a070;
        }

        .p-close {
            background: none;
            border: none;
            cursor: pointer;
            color: #505560;
            font-size: 14px;
            line-height: 1;
            padding: 0 2px;
        }

            .p-close:hover {
                color: #e8eaf0;
            }

        .light-theme .p-close:hover {
            color: #111;
        }

        /* ── Panel tabs (Devices / Zones) ── */
        .panel-tabs {
            display: flex;
            border-bottom: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

        .light-theme .panel-tabs {
            border-bottom-color: rgba(0,0,0,.08);
        }

        .ptab {
            flex: 1;
            background: none;
            border: none;
            color: #8890a0;
            font-size: 10.5px;
            font-weight: 700;
            padding: 9px 0;
            cursor: pointer;
            font-family: 'Space Mono',monospace;
            letter-spacing: .04em;
            border-bottom: 2px solid transparent;
            transition: color .15s, border-color .15s;
        }

            .ptab:hover:not(.active) {
                color: #c0c4cc;
            }

            .ptab.active {
                color: #00e5a0;
                border-bottom-color: #00e5a0;
            }

        .light-theme .ptab.active {
            color: #00a070;
            border-bottom-color: #00a070;
        }

        .ptab-badge {
            margin-left: 3px;
            background: rgba(255,255,255,.08);
            color: inherit;
            border-radius: 8px;
            padding: 0 5px;
            font-size: 9px;
        }

        .panel-tab-body {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Search */
        #dev-search-wrap {
            position: relative;
            padding: 9px 13px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

        .light-theme #dev-search-wrap {
            border-bottom-color: rgba(0,0,0,.08);
        }

        #dev-search {
            width: 100%;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 6px;
            color: #e8eaf0;
            font-size: 12px;
            padding: 7px 9px;
            outline: none;
            box-sizing: border-box;
            font-family: 'DM Sans','Segoe UI',sans-serif;
        }

        .light-theme #dev-search {
            background: rgba(0,0,0,.04);
            border-color: rgba(0,0,0,.15);
            color: #111;
        }

        #dev-search:focus {
            border-color: #00e5a0;
        }

        #dev-search-clear {
            position: absolute;
            right: 21px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #505560;
            cursor: pointer;
            font-size: 12px;
            display: none;
        }

            #dev-search-clear.show {
                display: block;
            }

        #dev-suggest {
            position: absolute;
            left: 13px;
            right: 13px;
            top: 100%;
            margin-top: 2px;
            background: rgba(10,12,15,.97);
            border: 1px solid rgba(0,229,160,.25);
            border-radius: 7px;
            max-height: 220px;
            overflow-y: auto;
            z-index: 30;
            display: none;
            box-shadow: 0 8px 24px rgba(0,0,0,.4);
        }

        .light-theme #dev-suggest {
            background: rgba(255,255,255,.98);
            border-color: rgba(0,160,112,.3);
        }

        #dev-suggest.show {
            display: block;
        }

        .sugg-row {
            padding: 8px 12px;
            font-size: 11.5px;
            cursor: pointer;
            color: #e8eaf0;
            border-bottom: 1px solid rgba(255,255,255,.04);
        }

        .light-theme .sugg-row {
            color: #111;
            border-bottom-color: rgba(0,0,0,.05);
        }

        .sugg-row:last-child {
            border-bottom: none;
        }

        .sugg-row:hover {
            background: rgba(0,229,160,.1);
        }

        .sugg-row .sg-imei {
            font-family: 'Space Mono',monospace;
            font-size: 9px;
            color: #505560;
            margin-top: 1px;
        }

        .sugg-empty {
            padding: 10px 12px;
            font-size: 11px;
            color: #505560;
            text-align: center;
        }

        #dev-list {
            overflow-y: auto;
            flex: 1;
        }

            #dev-list::-webkit-scrollbar {
                width: 3px;
            }

            #dev-list::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.1);
                border-radius: 2px;
            }

        .dev-row {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 13px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            cursor: pointer;
            transition: background .12s;
        }

        .light-theme .dev-row {
            border-bottom-color: rgba(0,0,0,.05);
        }

        .dev-row:last-child {
            border-bottom: none;
        }

        .dev-row:hover {
            background: rgba(255,255,255,.04);
        }

        .light-theme .dev-row:hover {
            background: rgba(0,0,0,.04);
        }

        .dev-row.active {
            background: rgba(0,229,160,.07);
        }

        .dev-ico {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255,255,255,.05);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
        }

        .light-theme .dev-ico {
            background: rgba(0,0,0,.05);
        }

        .dev-info {
            flex: 1;
            min-width: 0;
        }

        .dev-name {
            font-size: 12px;
            font-weight: 600;
            color: #e8eaf0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .light-theme .dev-name {
            color: #111;
        }

        .dev-imei {
            font-family: 'Space Mono',monospace;
            font-size: 9px;
            color: #505560;
            margin-top: 1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dev-geo {
            font-size: 9px;
            color: #f59e0b;
            margin-top: 1px;
            display: none;
        }

            .dev-geo.show {
                display: block;
            }

        .dev-st {
            font-size: 10px;
            font-weight: 700;
            flex-shrink: 0;
        }

            .dev-st.online {
                color: #00e5a0;
            }

            .dev-st.offline {
                color: #ff4b4b;
            }

        /* ── Zones tab ── */
        #zone-list {
            overflow-y: auto;
            flex: 1;
        }

            #zone-list::-webkit-scrollbar {
                width: 3px;
            }

            #zone-list::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.1);
                border-radius: 2px;
            }

        .zone-row {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 13px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            cursor: pointer;
            transition: background .12s;
        }

        .light-theme .zone-row {
            border-bottom-color: rgba(0,0,0,.05);
        }

        .zone-row:last-child {
            border-bottom: none;
        }

        .zone-row:hover {
            background: rgba(255,255,255,.04);
        }

        .light-theme .zone-row:hover {
            background: rgba(0,0,0,.04);
        }

        .zone-row.active {
            background: rgba(0,229,160,.07);
        }

        .zone-row.all-zones {
            font-weight: 600;
        }

        .zone-swatch {
            width: 14px;
            height: 14px;
            border-radius: 4px;
            flex-shrink: 0;
            border: 1.5px solid rgba(255,255,255,.5);
        }

        .light-theme .zone-swatch {
            border-color: rgba(0,0,0,.15);
        }

        .zone-info {
            flex: 1;
            min-width: 0;
        }

        .zone-name {
            font-size: 12px;
            font-weight: 600;
            color: #e8eaf0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .light-theme .zone-name {
            color: #111;
        }

        .zone-sub {
            font-family: 'Space Mono',monospace;
            font-size: 9px;
            color: #505560;
            margin-top: 1px;
        }

        .zone-count {
            font-size: 10px;
            font-weight: 700;
            color: #f59e0b;
            background: rgba(245,158,11,.12);
            padding: 2px 7px;
            border-radius: 10px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        /* Zone label pill rendered on the map itself */
        .zone-pill {
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            font-family: 'Space Mono',monospace;
            padding: 3px 9px;
            border-radius: 5px;
            white-space: nowrap;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,.3);
            border: 1.5px solid rgba(255,255,255,.35);
            letter-spacing: .02em;
        }

        /* ── Panel FAB ── */
        #panel-fab {
            position: absolute;
            top: 62px;
            left: 12px;
            z-index: 16;
            background: rgba(10,12,15,.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 8px;
            padding: 9px 11px;
            cursor: pointer;
            color: #00e5a0;
            font-size: 17px;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .light-theme #panel-fab {
            background: rgba(255,255,255,.93);
            border-color: rgba(0,0,0,.1);
        }

        #panel-fab.show {
            display: flex;
        }

        #panel-fab:hover {
            background: rgba(0,229,160,.1);
        }

        /* ── Footer bar ── */
        #map-foot {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(10,12,15,.88);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 8px;
            padding: 7px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            z-index: 15;
            font-size: 11px;
            color: #505560;
            font-family: 'Space Mono',monospace;
            white-space: nowrap;
        }

        .light-theme #map-foot {
            background: rgba(255,255,255,.9);
            border-color: rgba(0,0,0,.1);
            color: #888;
        }

        #map-foot strong {
            color: #00e5a0;
        }

        .light-theme #map-foot strong {
            color: #00a070;
        }

        #map-foot .geo-count {
            color: #f59e0b;
        }

        #map-foot .foot-sep {
            width: 1px;
            height: 13px;
            background: rgba(255,255,255,.12);
            flex-shrink: 0;
        }

        .light-theme #map-foot .foot-sep {
            background: rgba(0,0,0,.15);
        }

        /* ── Loading overlay ── */
        #map-loading {
            position: absolute;
            inset: 0;
            background: rgba(10,12,15,.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 50;
            gap: 14px;
        }

        .light-theme #map-loading {
            background: rgba(248,249,252,.95);
        }

        #map-loading.gone {
            display: none;
        }

        .ld-ring {
            width: 36px;
            height: 36px;
            border: 2px solid rgba(255,255,255,.08);
            border-top-color: #00e5a0;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        .light-theme .ld-ring {
            border-color: rgba(0,0,0,.08);
            border-top-color: #00a070;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .ld-txt {
            font-family: 'Space Mono',monospace;
            font-size: 10px;
            color: #505560;
            letter-spacing: .1em;
        }

        /* ── Error toast ── */
        #err-toast {
            position: absolute;
            top: 62px;
            right: 12px;
            background: rgba(255,75,75,.12);
            border: 1px solid rgba(255,75,75,.35);
            border-radius: 8px;
            padding: 9px 14px;
            font-size: 11px;
            color: #ff4b4b;
            z-index: 20;
            display: none;
            max-width: 280px;
        }

            #err-toast.show {
                display: block;
            }

        /* ── Geofence / zone tooltip ── */
        #geo-tooltip {
            position: absolute;
            pointer-events: none;
            background: rgba(10,12,15,.92);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(245,158,11,.4);
            border-radius: 7px;
            padding: 7px 12px;
            font-size: 11px;
            color: #e8eaf0;
            z-index: 25;
            display: none;
            white-space: nowrap;
            font-family: 'Space Mono',monospace;
        }

        .light-theme #geo-tooltip {
            background: rgba(255,255,255,.95);
            color: #222;
            border-color: rgba(180,100,0,.4);
        }

        #geo-tooltip.show {
            display: block;
        }

        #geo-tooltip .gt-name {
            font-weight: 700;
            color: #f59e0b;
            font-size: 12px;
            margin-bottom: 3px;
        }

        .light-theme #geo-tooltip .gt-name {
            color: #d97706;
        }

        #geo-tooltip .gt-radius {
            color: #888;
            font-size: 10px;
        }
    </style>
}

<div id="trackmap-root">
    <div id="gmap"></div>

    <div id="map-loading">
        <div class="ld-ring"></div>
        <div class="ld-txt">INITIALISING MAP…</div>
    </div>

    <div id="map-hud">
        <span class="hud-logo">◈ TRACKMAP</span>
        <span class="hud-sep"></span>
        <span class="stat-chip"><span class="dot dot-b"></span>Total&nbsp;<strong id="h-tot">—</strong></span>
        <span class="stat-chip"><span class="dot dot-g"></span>Online&nbsp;<strong id="h-on">—</strong></span>
        <span class="stat-chip"><span class="dot dot-r"></span>Offline&nbsp;<strong id="h-off">—</strong></span>
        <span class="stat-chip"><span class="dot dot-y"></span>Zones&nbsp;<strong id="h-geo">—</strong></span>
        <div class="hud-right">
            <label class="zoom-lock-wrap" title="Lock the map at a fixed zoom level — auto-center will pan only, never re-zoom">
                🔍 Zoom
                <select id="zoom-lock-select">
                    <option value="">Auto</option>
                </select>
            </label>
            <span class="hud-sep"></span>
            <button class="btn-h accent active" id="autocenter-btn">⌖ Auto-Center: ON</button>
            <span class="hud-sep"></span>
            <span id="refresh-cd">⟳ <span id="cd-val">10s</span></span>
            <span class="hud-sep"></span>
            <a href="/Track/Play" class="btn-h">▶ Playback</a>
            <a href="/Home/Index" class="btn-h accent">⌂ Dashboard</a>
        </div>
    </div>

    <div id="dev-panel">
        <div class="p-head">
            <span class="p-title">Fleet</span>
            <button class="p-close" id="p-close-btn">✕</button>
        </div>

        <div class="panel-tabs">
            <button class="ptab active" id="tab-devices" onclick="switchPanelTab('devices')">
                🚚 Devices <span class="ptab-badge" id="tab-devices-count">0</span>
            </button>
            <button class="ptab" id="tab-zones" onclick="switchPanelTab('zones')">
                🅿 Zones <span class="ptab-badge" id="tab-zones-count">0</span>
            </button>
        </div>

        <div id="devices-tab" class="panel-tab-body">
            <div id="dev-search-wrap">
                <input type="text" id="dev-search" placeholder="Search IMEI, vehicle no or device name…" autocomplete="off" />
                <button id="dev-search-clear" title="Clear">✕</button>
                <div id="dev-suggest"></div>
            </div>
            <div id="dev-list">
                <div style="padding:20px;text-align:center;color:#505560;font-size:11px;">Loading…</div>
            </div>
        </div>

        <div id="zones-tab" class="panel-tab-body" style="display:none">
            <div id="zone-list">
                <div style="padding:20px;text-align:center;color:#505560;font-size:11px;">Loading…</div>
            </div>
        </div>
    </div>

    <button id="panel-fab" title="Show devices">☰</button>

    <div id="map-foot">
        <span>⏱ Now: <strong id="foot-now">—</strong></span>
        <span class="foot-sep"></span>
        <span>Map updated: <strong id="foot-time">—</strong></span>
        <span class="foot-sep"></span>
        <span>Zones: <span class="geo-count" id="foot-geo">0</span></span>
    </div>

    <div id="geo-tooltip">
        <div class="gt-name" id="gt-name"></div>
        <div class="gt-radius" id="gt-radius"></div>
    </div>

    <div id="err-toast"></div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            /* ── theme ─────────────────────────────────────────────────
               Detects the same "dark-theme" convention the rest of the app
               uses (see Dashboard.cshtml), not "light-theme" — that mismatch
               used to leave this page stuck on its dark default. ───────── */
            const root = document.getElementById('trackmap-root');
            function isDarkTheme() {
                return document.documentElement.classList.contains('dark-theme') ||
                    document.body.classList.contains('dark-theme') ||
                    document.documentElement.getAttribute('data-theme') === 'dark';
            }
            function isLight() { return !isDarkTheme(); }
            function applyTheme() {
                root.classList.toggle('light-theme', isLight());
                if (window._mapInst) applyMapStyle(window._mapInst);
            }
            new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
            new MutationObserver(applyTheme).observe(document.body, { attributes: true, attributeFilter: ['class', 'data-theme'] });

            /* ── state ─────────────────────────────────────────────── */
            let map, infoWin;
            let markers = {};   // keyed by IMEI → { marker, el, data, pos }
            let devices = [];
            let geofences = [];
            let parkingPoints = [];
            let zonePolys = {};        // geoId -> { polygon, labelMarker, color, geo, pts }
            let activeGeoFilter = null; // null = show every zone; a geoId = isolate that zone
            let lastGeofences = [];
            let lastDevByGeo = {};
            let autoCenter = true;
            let followImei = null;
            let firstLoad = true;
            let searchTerm = '';
            let cdVal = 10, cdTimer;
            let lockedZoom = null; // null = auto zoom; number = user-locked zoom

            /* ════════════════════════════════════════════════════════
               TRUCK SVG — returns an SVG string for a given status.
               ════════════════════════════════════════════════════════ */
            function truckSVG(online) {
                const body = online ? '#00c78c' : '#6b7280';
                const cabin = online ? '#00a372' : '#4b5563';
                const wheel = online ? '#1a1a2e' : '#374151';
                const glass = online ? '#b2f0e0' : '#9ca3af';
                const outline = online ? '#005a40' : '#374151';

                return `
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="40" height="40">
                                  <ellipse cx="24" cy="44" rx="13" ry="3" fill="rgba(0,0,0,0.25)"/>
                                  <rect x="4" y="18" width="28" height="18" rx="3" fill="${body}" stroke="${outline}" stroke-width="1.2"/>
                                  <rect x="5" y="18" width="26" height="3" rx="2" fill="${cabin}" opacity="0.4"/>
                                  <rect x="28" y="22" width="14" height="14" rx="3" fill="${cabin}" stroke="${outline}" stroke-width="1.2"/>
                                  <rect x="30" y="23.5" width="9" height="7" rx="1.5" fill="${glass}" opacity="0.85"/>
                                  <line x1="31" y1="24.5" x2="33" y2="29" stroke="white" stroke-width="0.8" opacity="0.5"/>
                                  <rect x="40" y="28" width="3" height="2.5" rx="1" fill="#fde68a"/>
                                  <circle cx="10" cy="37" r="4.5" fill="${wheel}" stroke="${outline}" stroke-width="1"/>
                                  <circle cx="10" cy="37" r="2"   fill="#4b5563"/>
                                  <circle cx="22" cy="37" r="4.5" fill="${wheel}" stroke="${outline}" stroke-width="1"/>
                                  <circle cx="22" cy="37" r="2"   fill="#4b5563"/>
                                  <circle cx="36" cy="37" r="4.5" fill="${wheel}" stroke="${outline}" stroke-width="1"/>
                                  <circle cx="36" cy="37" r="2"   fill="#4b5563"/>
                                  <polygon points="7,26 13,22 13,30" fill="white" opacity="0.35"/>
                                </svg>`;
            }

            /* ════════════════════════════════════════════════════════
               BUILD MARKER ELEMENT
               ════════════════════════════════════════════════════════ */
            function buildMarkerEl(d) {
                const online = d.status === 'online';

                const wrap = document.createElement('div');
                wrap.className = 'truck-marker-wrap' + (online ? '' : ' offline');

                const halo = document.createElement('div');
                halo.className = 'gps-halo';
                halo.innerHTML = `<div class="ring"></div><div class="ring ring2"></div><div class="core"></div>`;
                wrap.appendChild(halo);

                const svgWrap = document.createElement('div');
                svgWrap.className = 'truck-svg-wrap';
                svgWrap.innerHTML = truckSVG(online);
                wrap.appendChild(svgWrap);

                const label = document.createElement('div');
                label.className = 'truck-label';
                label.textContent = d.imei || 'Device';   // ← IMEI is the marker's identity; vehicle no shows on click
                wrap.appendChild(label);

                return wrap;
            }

            /* ── Map init ───────────────────────────────────────────── */
            async function initMap() {
                const { Map } = await google.maps.importLibrary('maps');
                const { AdvancedMarkerElement } = await google.maps.importLibrary('marker');
                window._AdvMarker = AdvancedMarkerElement;

                map = new Map(document.getElementById('gmap'), {
                    center: { lat: 19.076, lng: 72.8777 }, zoom: 11,
                    mapId: 'DEMO_MAP_ID',
                    disableDefaultUI: false, zoomControl: true,
                    mapTypeControl: false, streetViewControl: false, fullscreenControl: false
                });
                window._mapInst = map;
                applyMapStyle(map);
                infoWin = new google.maps.InfoWindow();

                map.addListener('dragstart', () => {
                    if (autoCenter) { autoCenter = false; updateAutoCenterBtn(); }
                });

                map.addListener('zoom_changed', () => {
                    if (lockedZoom !== null) {
                        const z = map.getZoom();
                        if (z !== lockedZoom) {
                            lockedZoom = z;
                            zoomSelect.value = String(z in zoomOptionSet ? z : '');
                        }
                    }
                });

                document.getElementById('map-loading').classList.add('gone');
                fetchDevices();
                startCd();
                startClock();
            }

            function applyMapStyle(m) {
                m.setOptions({ styles: isLight() ? [] : darkStyle() });
            }

            /* ── Fetch ─────────────────────────────────────────────── */
            async function fetchDevices() {
                try {
                    const r = await fetch('/Home/DashboardMapJson?_=' + Date.now(), {
                        cache: 'no-store',
                        headers: { 'Cache-Control': 'no-cache' }
                    });
                    const d = await r.json();
                    if (!d.ok) throw new Error(d.error || 'Server error');
                    devices = d.devices || [];
                    geofences = d.geoFences || [];
                    parkingPoints = d.parking || [];

                    renderPanel(getFiltered());
                    renderMarkers(devices);
                    renderGeofences(geofences, parkingPoints, devices);
                    updateStats(devices);
                    applyAutoCenter(devices);

                    document.getElementById('foot-time').textContent = new Date().toLocaleTimeString();
                    document.getElementById('foot-geo').textContent = geofences.length;
                    document.getElementById('h-geo').textContent = geofences.length;
                    document.getElementById('tab-zones-count').textContent = geofences.length;
                    hideErr();
                } catch (e) { showErr(e.message); }
            }

            /* ── Stats ──────────────────────────────────────────────── */
            function updateStats(devs) {
                const on = devs.filter(d => d.status === 'online').length;
                document.getElementById('h-tot').textContent = devs.length;
                document.getElementById('h-on').textContent = on;
                document.getElementById('h-off').textContent = devs.length - on;
                document.getElementById('tab-devices-count').textContent = devs.length;
            }

            /* ── Panel tabs (Devices / Zones) ─────────────────────── */
            window.switchPanelTab = function (tab) {
                document.getElementById('tab-devices').classList.toggle('active', tab === 'devices');
                document.getElementById('tab-zones').classList.toggle('active', tab === 'zones');
                document.getElementById('devices-tab').style.display = tab === 'devices' ? 'flex' : 'none';
                document.getElementById('zones-tab').style.display = tab === 'zones' ? 'flex' : 'none';
            };

            /* ── Auto-center ────────────────────────────────────────── */
            function updateAutoCenterBtn() {
                const btn = document.getElementById('autocenter-btn');
                btn.classList.toggle('active', autoCenter);
                btn.textContent = autoCenter ? '⌖ Auto-Center: ON' : '⌖ Auto-Center: OFF';
            }
            document.getElementById('autocenter-btn').addEventListener('click', () => {
                autoCenter = !autoCenter;
                updateAutoCenterBtn();
                if (autoCenter) applyAutoCenter(devices);
            });

            function applyAutoCenter(devs) {
                if (!autoCenter || !map) return;
                const withPos = devs.filter(d => d.latitude && d.longitude);
                if (!withPos.length) return;

                let target = null;
                if (followImei) {
                    const d = withPos.find(x => x.imei === followImei);
                    if (d) target = { lat: d.latitude, lng: d.longitude };
                }
                if (!target && withPos.length === 1) {
                    target = { lat: withPos[0].latitude, lng: withPos[0].longitude };
                }
                if (!target) {
                    const bounds = new google.maps.LatLngBounds();
                    withPos.forEach(d => bounds.extend({ lat: d.latitude, lng: d.longitude }));
                    target = bounds.getCenter();
                }

                if (lockedZoom !== null) {
                    map.panTo(target);
                } else if (followImei || withPos.length === 1) {
                    map.panTo(target);
                    if (firstLoad) map.setZoom(16);
                } else {
                    const bounds = new google.maps.LatLngBounds();
                    withPos.forEach(d => bounds.extend({ lat: d.latitude, lng: d.longitude }));
                    map.fitBounds(bounds, { padding: 90 });
                }
                firstLoad = false;
            }

            /* ── Zoom lock control ─────────────────────────────────── */
            const zoomSelect = document.getElementById('zoom-lock-select');
            const zoomOptionSet = {};
            for (let z = 5; z <= 21; z++) {
                zoomOptionSet[z] = true;
                const opt = document.createElement('option');
                opt.value = String(z);
                opt.textContent = 'Zoom ' + z;
                zoomSelect.appendChild(opt);
            }
            zoomSelect.addEventListener('change', () => {
                const v = zoomSelect.value;
                if (v === '') {
                    lockedZoom = null;
                } else {
                    lockedZoom = parseInt(v, 10);
                    if (map) map.setZoom(lockedZoom);
                }
            });

            /* ── Search / autocomplete (IMEI, device name, vehicle no) ── */
            function getFiltered() {
                if (!searchTerm) return devices;
                const q = searchTerm.toLowerCase();
                return devices.filter(d =>
                    (d.imei || '').toLowerCase().includes(q) ||
                    (d.name || '').toLowerCase().includes(q) ||
                    (d.vehicleNo || '').toLowerCase().includes(q)
                );
            }

            const searchInput = document.getElementById('dev-search');
            const suggestBox = document.getElementById('dev-suggest');
            const clearBtn = document.getElementById('dev-search-clear');

            searchInput.addEventListener('input', () => {
                searchTerm = searchInput.value.trim();
                clearBtn.classList.toggle('show', !!searchTerm);
                renderSuggestions(searchTerm);
                renderPanel(getFiltered());
            });
            searchInput.addEventListener('focus', () => { if (searchTerm) renderSuggestions(searchTerm); });
            document.addEventListener('click', e => { if (!e.target.closest('#dev-search-wrap')) suggestBox.classList.remove('show'); });
            clearBtn.addEventListener('click', () => {
                searchInput.value = ''; searchTerm = '';
                clearBtn.classList.remove('show'); suggestBox.classList.remove('show');
                renderPanel(getFiltered()); searchInput.focus();
            });

            function renderSuggestions(q) {
                if (!q) { suggestBox.classList.remove('show'); return; }
                const ql = q.toLowerCase();
                const hits = devices.filter(d =>
                    (d.imei || '').toLowerCase().includes(ql) ||
                    (d.name || '').toLowerCase().includes(ql) ||
                    (d.vehicleNo || '').toLowerCase().includes(ql)
                ).slice(0, 8);

                suggestBox.innerHTML = hits.length
                    ? hits.map(d => {
                        const hint = [d.vehicleNo, d.name].filter(Boolean).join(' · ');
                        return `<div class="sugg-row" data-imei="${ea(d.imei)}">${esc(d.imei)}${hint ? `<div class="sg-imei">${esc(hint)}</div>` : ''}</div>`;
                    }).join('')
                    : '<div class="sugg-empty">No matching devices</div>';
                suggestBox.classList.add('show');
                suggestBox.querySelectorAll('.sugg-row').forEach(row => {
                    row.addEventListener('click', () => {
                        const imei = row.dataset.imei;
                        searchInput.value = imei; searchTerm = imei;
                        clearBtn.classList.add('show'); suggestBox.classList.remove('show');
                        renderPanel(getFiltered()); focusDevByImei(imei);
                    });
                });
            }

            /* ── Device panel list ──────────────────────────────────── */
            function renderPanel(devs) {
                const el = document.getElementById('dev-list');
                if (!devs.length) {
                    el.innerHTML = '<div style="padding:20px;text-align:center;color:#505560;font-size:11px">No devices found.</div>';
                    return;
                }
                el.innerHTML = devs.map(d => `
                        <div class="dev-row" data-imei="${ea(d.imei)}" onclick="focusDevByImei('${ea(d.imei)}')">
                            <div class="dev-ico">${truckSVG(d.status === 'online')}</div>
                            <div class="dev-info">
                                <div class="dev-name">${esc(d.imei)}</div>
                                <div class="dev-imei">${esc(d.name || 'No zone')}</div>
                                ${d.geofence > 0 ? `<div class="dev-geo show">🅿 ${d.geofence}m zone</div>` : ''}
                            </div>
                            <div class="dev-st ${d.status}">${d.status === 'online' ? '●LIVE' : '○OFF'}</div>
                        </div>`).join('');
            }

            window.focusDevByImei = function (imei) {
                const d = devices.find(x => x.imei === imei);
                if (!d || !d.latitude || !d.longitude) return;
                followImei = imei;
                map.panTo({ lat: d.latitude, lng: d.longitude });
                if (lockedZoom === null) map.setZoom(15);
                const rec = markers[imei];
                if (rec) openInfo(rec, d);
                document.querySelectorAll('.dev-row').forEach(r =>
                    r.classList.toggle('active', r.getAttribute('data-imei') === imei));
            };

            /* ════════════════════════════════════════════════════════
               RENDER MARKERS
               ════════════════════════════════════════════════════════ */
            function renderMarkers(devs) {
                const seen = new Set();
                devs.forEach(d => {
                    if (!d.latitude || !d.longitude) return;
                    seen.add(d.imei);
                    const pos = { lat: d.latitude, lng: d.longitude };

                    if (markers[d.imei]) {
                        const rec = markers[d.imei];
                        const wasOnline = !rec.el.classList.contains('offline');
                        const isOnline = d.status === 'online';
                        if (wasOnline !== isOnline) {
                            const newEl = buildMarkerEl(d);
                            rec.marker.content = newEl;
                            rec.el = newEl;
                        }
                        rec.data = d;
                        animateMarkerTo(rec, pos);
                    } else {
                        const el = buildMarkerEl(d);
                        const mk = new window._AdvMarker({
                            position: pos,
                            map,
                            content: el,
                            title: d.vehicleNo || d.name || d.imei
                        });
                        const rec = { marker: mk, el, data: d, pos };
                        el.addEventListener('click', () => openInfo(rec, d));
                        markers[d.imei] = rec;
                    }
                });

                Object.keys(markers).forEach(k => {
                    if (!seen.has(k)) { markers[k].marker.map = null; delete markers[k]; }
                });
            }

            function animateMarkerTo(rec, newPos) {
                const from = rec.pos || newPos;
                if (from.lat === newPos.lat && from.lng === newPos.lng) { rec.pos = newPos; return; }

                const duration = 900;
                const start = performance.now();

                function step(now) {
                    const t = Math.min(1, (now - start) / duration);
                    const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
                    const lat = from.lat + (newPos.lat - from.lat) * eased;
                    const lng = from.lng + (newPos.lng - from.lng) * eased;
                    rec.marker.position = { lat, lng };
                    if (t < 1) {
                        requestAnimationFrame(step);
                    } else {
                        rec.pos = newPos;
                    }
                }
                requestAnimationFrame(step);
            }

            /* Info-window content */
            function openInfo(rec, d) {
                const geoHtml = d.geofence > 0
                    ? `<div style="font-size:11px;color:#555;margin-top:4px">🅿 Zone: <b style="color:#d97706">${d.geofence}m radius</b></div>`
                    : '';
                const vehicleHtml = d.vehicleNo
                    ? `<div style="font-size:11px;color:#555">Vehicle: <b style="color:#111">${esc(d.vehicleNo)}</b></div>`
                    : '';
                infoWin.setContent(`
                                    <div style="font-family:'Segoe UI',sans-serif;padding:2px;min-width:180px">
                                        <b style="font-size:13px">${esc(d.vehicleNo || d.name || 'Device')}</b>
                                        ${vehicleHtml}
                                        <div style="margin-top:6px;font-size:11px;color:#555">IMEI: <b style="color:#111">${esc(d.imei)}</b></div>
                                        <div style="font-size:11px;color:#555">Status: <b style="color:${d.status === 'online' ? '#00a070' : '#c00'}">${(d.status || '').toUpperCase()}</b></div>
                                        <div style="font-size:11px;color:#555">Last Seen: <b style="color:#111">${esc(d.lastSeen || '—')}</b></div>
                                        <div style="font-size:11px;color:#555">Coords: <b style="color:#111">${d.latitude.toFixed(5)}, ${d.longitude.toFixed(5)}</b></div>
                                        ${geoHtml}
                                        <hr style="margin:7px 0;border:none;border-top:1px solid #eee"/>
                                        <a href="/Track/Play?imei=${encodeURIComponent(d.imei)}" style="font-size:11px;color:#0070e0;font-weight:600">▶ View Playback →</a>
                                    </div>`);
                infoWin.open(map, rec.marker);
            }

            /* ════════════════════════════════════════════════════════
               PARKING ZONES (polygons) — same boundary algorithm as the
               dashboard map: convex hull seed + cheapest insertion, so
               every recorded coordinate becomes a polygon vertex with no
               self-crossing edges. Fill is lighter here (18%) than the
               dashboard's 30% since this page is dense with live trucks.
               ════════════════════════════════════════════════════════ */
            function zoneColor(i) {
                const palette = [
                    { stroke: '#2563eb', fill: 'rgba(37,99,235,.18)' },
                    { stroke: '#16a34a', fill: 'rgba(22,163,74,.18)' },
                    { stroke: '#dc2626', fill: 'rgba(220,38,38,.18)' },
                    { stroke: '#9333ea', fill: 'rgba(147,51,234,.18)' },
                    { stroke: '#ea580c', fill: 'rgba(234,88,12,.18)' },
                    { stroke: '#0891b2', fill: 'rgba(8,145,178,.18)' },
                    { stroke: '#db2777', fill: 'rgba(219,39,119,.18)' },
                    { stroke: '#65a30d', fill: 'rgba(101,163,13,.18)' }
                ];
                return palette[i % palette.length];
            }

            function haversineKm(la1, lo1, la2, lo2) {
                const R = 6371, toRad = x => x * Math.PI / 180;
                const dLat = toRad(la2 - la1), dLng = toRad(lo2 - lo1);
                const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(la1)) * Math.cos(toRad(la2)) * Math.sin(dLng / 2) ** 2;
                return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            }

            function computeConvexHull(points) {
                const pts = points.slice().sort((a, b) => a.longitude - b.longitude || a.latitude - b.latitude);
                const cross = (o, a, b) =>
                    (a.longitude - o.longitude) * (b.latitude - o.latitude) -
                    (a.latitude - o.latitude) * (b.longitude - o.longitude);
                const lower = [];
                for (const p of pts) {
                    while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop();
                    lower.push(p);
                }
                const upper = [];
                for (let i = pts.length - 1; i >= 0; i--) {
                    const p = pts[i];
                    while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop();
                    upper.push(p);
                }
                lower.pop(); upper.pop();
                const hull = lower.concat(upper);
                return hull.length >= 3 ? hull : pts;
            }

            function fullBoundaryOrder(points) {
                if (points.length < 3) return points.slice();
                const seen = new Set(); const uniq = [];
                points.forEach(p => {
                    const key = p.longitude + ',' + p.latitude;
                    if (!seen.has(key)) { seen.add(key); uniq.push(p); }
                });
                if (uniq.length < 3) return uniq;
                const dist = (a, b) => haversineKm(a.latitude, a.longitude, b.latitude, b.longitude);
                let loop = computeConvexHull(uniq);
                const inLoop = new Set(loop);
                let remaining = uniq.filter(p => !inLoop.has(p));
                while (remaining.length) {
                    let bestPtIdx = -1, bestEdgeIdx = -1, bestCost = Infinity;
                    for (let ri = 0; ri < remaining.length; ri++) {
                        const p = remaining[ri];
                        for (let ei = 0; ei < loop.length; ei++) {
                            const a = loop[ei], b = loop[(ei + 1) % loop.length];
                            const cost = dist(a, p) + dist(p, b) - dist(a, b);
                            if (cost < bestCost) { bestCost = cost; bestPtIdx = ri; bestEdgeIdx = ei; }
                        }
                    }
                    const point = remaining[bestPtIdx];
                    loop.splice(bestEdgeIdx + 1, 0, point);
                    remaining.splice(bestPtIdx, 1);
                }
                return loop;
            }

            function computeDevicesByGeo(devs, geos) {
                const out = {};
                geos.forEach(g => {
                    if (!g.latitude || !g.longitude) { out[g.id] = []; return; }
                    const radiusKm = Math.max(g.radiusMeters || 0, 30) / 1000;
                    out[g.id] = devs.filter(d => d.latitude && d.longitude &&
                        haversineKm(g.latitude, g.longitude, d.latitude, d.longitude) <= radiusKm);
                });
                return out;
            }

            function renderGeofences(geos, parking, devs) {
                Object.values(zonePolys).forEach(z => {
                    if (z.polygon) z.polygon.setMap(null);
                    if (z.labelMarker) z.labelMarker.map = null;
                });
                zonePolys = {};

                if (!geos || !geos.length) { lastGeofences = []; lastDevByGeo = {}; renderZonePanel(); return; }

                const pkByLoc = {};
                (parking || []).forEach(p => {
                    const k = p.parkingLocationId;
                    (pkByLoc[k] = pkByLoc[k] || []).push(p);
                });

                const devByGeo = computeDevicesByGeo(devs, geos);

                geos.forEach((g, idx) => {
                    if (!g.latitude || !g.longitude) return;
                    const clr = zoneColor(idx);
                    const pts = pkByLoc[g.id] || [];
                    const visible = activeGeoFilter === null || String(activeGeoFilter) === String(g.id);
                    let polygon = null;

                    if (pts.length >= 2) {
                        const ordered = fullBoundaryOrder(pts);
                        const path = ordered.map(p => ({ lat: p.latitude, lng: p.longitude }));
                        polygon = new google.maps.Polygon({
                            map: visible ? map : null,
                            paths: path, geodesic: true, clickable: true,
                            strokeColor: clr.stroke, strokeOpacity: .8, strokeWeight: 2,
                            fillColor: clr.stroke, fillOpacity: .18, zIndex: 1
                        });
                        polygon.addListener('mouseover', e => showZoneTip(g, pts.length, e.domEvent));
                        polygon.addListener('mousemove', e => positionTooltip(e.domEvent));
                        polygon.addListener('mouseout', () => document.getElementById('geo-tooltip').classList.remove('show'));
                        polygon.addListener('click', () => zoomToZone(g.id));
                    }

                    const lbl = document.createElement('div');
                    lbl.className = 'zone-pill';
                    lbl.style.background = clr.stroke;
                    lbl.textContent = '🅿 ' + (g.name || ('Zone ' + g.id));
                    lbl.addEventListener('click', () => zoomToZone(g.id));
                    const lm = new window._AdvMarker({
                        position: { lat: g.latitude, lng: g.longitude },
                        map: visible ? map : null,
                        content: lbl, zIndex: 8
                    });

                    zonePolys[g.id] = { polygon, labelMarker: lm, color: clr, geo: g, pts };
                });

                lastGeofences = geos;
                lastDevByGeo = devByGeo;
                renderZonePanel();
            }

            function showZoneTip(g, ptCount, domEvent) {
                document.getElementById('gt-name').textContent = g.name || ('Zone ' + g.id);
                document.getElementById('gt-radius').textContent = `${ptCount} pts · r=${g.radiusMeters}m`;
                document.getElementById('geo-tooltip').classList.add('show');
                positionTooltip(domEvent);
            }

            function applyZoneFilter() {
                Object.keys(zonePolys).forEach(gid => {
                    const z = zonePolys[gid];
                    const visible = activeGeoFilter === null || String(gid) === String(activeGeoFilter);
                    if (z.polygon) z.polygon.setMap(visible ? map : null);
                    if (z.labelMarker) z.labelMarker.map = visible ? map : null;
                });
            }

            /* Clicking a zone (in the panel or on the map) isolates it —
               hides every other zone's polygon/label/dots. Truck markers
               are deliberately unaffected, exactly like the old geofence
               toggle worked. */
            window.zoomToZone = function (geoId) {
                activeGeoFilter = geoId;
                applyZoneFilter();
                renderZonePanel();
                const z = zonePolys[geoId];
                if (!z) return;
                if (z.polygon) {
                    const bounds = new google.maps.LatLngBounds();
                    z.polygon.getPath().forEach(p => bounds.extend(p));
                    map.fitBounds(bounds, { padding: 90 });
                } else {
                    map.panTo({ lat: z.geo.latitude, lng: z.geo.longitude });
                    map.setZoom(17);
                }
            };

            window.showAllZones = function () {
                activeGeoFilter = null;
                applyZoneFilter();
                renderZonePanel();
            };

            function renderZonePanel() {
                const el = document.getElementById('zone-list');
                if (!el) return;
                if (!lastGeofences.length) {
                    el.innerHTML = '<div style="padding:20px;text-align:center;color:#505560;font-size:11px;">No parking zones found.</div>';
                    return;
                }
                const allRow = `<div class="zone-row all-zones ${activeGeoFilter === null ? 'active' : ''}" onclick="showAllZones()">
                                            <div class="zone-swatch" style="background:linear-gradient(135deg,#00e5a0,#0af)"></div>
                                            <div class="zone-info">
                                                <div class="zone-name">All Zones</div>
                                                <div class="zone-sub">${lastGeofences.length} total</div>
                                            </div>
                                        </div>`;
                const rows = lastGeofences.map(g => {
                    const z = zonePolys[g.id];
                    const clr = z ? z.color : zoneColor(0);
                    const cnt = (lastDevByGeo[g.id] || []).length;
                    const active = String(activeGeoFilter) === String(g.id);
                    return `<div class="zone-row ${active ? 'active' : ''}" data-geo-id="${g.id}" onclick="zoomToZone(${g.id})">
                                        <div class="zone-swatch" style="background:${clr.stroke}"></div>
                                        <div class="zone-info">
                                            <div class="zone-name">${esc(g.name || 'Zone ' + g.id)}</div>
                                            <div class="zone-sub">r=${g.radiusMeters}m</div>
                                        </div>
                                        <span class="zone-count">${cnt} 🚛</span>
                                    </div>`;
                }).join('');
                el.innerHTML = allRow + rows;
            }

            function positionTooltip(e) {
                if (!e) return;
                const rect = document.getElementById('gmap').getBoundingClientRect();
                const tip = document.getElementById('geo-tooltip');
                tip.style.left = (e.clientX - rect.left + 14) + 'px';
                tip.style.top = (e.clientY - rect.top - 10) + 'px';
            }

            /* ── Countdown / auto-refresh ───────────────────────────── */
            function startCd() {
                cdVal = 10; clearInterval(cdTimer);
                cdTimer = setInterval(() => {
                    document.getElementById('cd-val').textContent = (--cdVal) + 's';
                    if (cdVal <= 0) { cdVal = 10; fetchDevices(); }
                }, 1000);
            }

            /* ── Live "now" clock (footer) ──────────────────────────── */
            function startClock() {
                const tick = () => {
                    document.getElementById('foot-now').textContent = new Date().toLocaleTimeString();
                };
                tick();
                setInterval(tick, 1000);
            }

            /* ── Panel collapse ─────────────────────────────────────── */
            document.getElementById('p-close-btn').addEventListener('click', () => {
                document.getElementById('dev-panel').classList.add('collapsed');
                document.getElementById('panel-fab').classList.add('show');
            });
            document.getElementById('panel-fab').addEventListener('click', () => {
                document.getElementById('dev-panel').classList.remove('collapsed');
                document.getElementById('panel-fab').classList.remove('show');
            });

            /* ── Error helpers ──────────────────────────────────────── */
            function showErr(msg) { const t = document.getElementById('err-toast'); t.textContent = '⚠ ' + msg; t.classList.add('show'); }
            function hideErr() { document.getElementById('err-toast').classList.remove('show'); }

            /* ── Dark map style ─────────────────────────────────────── */
            function darkStyle() {
                return [
                    { elementType: 'geometry', stylers: [{ color: '#0f1117' }] },
                    { elementType: 'labels.text.stroke', stylers: [{ color: '#0f1117' }] },
                    { elementType: 'labels.text.fill', stylers: [{ color: '#4e5568' }] },
                    { featureType: 'administrative.locality', elementType: 'labels.text.fill', stylers: [{ color: '#9aa3b0' }] },
                    { featureType: 'poi', elementType: 'labels.text.fill', stylers: [{ color: '#505a68' }] },
                    { featureType: 'poi.park', elementType: 'geometry', stylers: [{ color: '#151c1e' }] },
                    { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#1e2330' }] },
                    { featureType: 'road', elementType: 'geometry.stroke', stylers: [{ color: '#212a37' }] },
                    { featureType: 'road.highway', elementType: 'geometry', stylers: [{ color: '#243044' }] },
                    { featureType: 'road.highway', elementType: 'labels.text.fill', stylers: [{ color: '#f3d19c' }] },
                    { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#070c14' }] },
                    { featureType: 'water', elementType: 'labels.text.fill', stylers: [{ color: '#3d5061' }] }
                ];
            }

            /* ── Helpers ────────────────────────────────────────────── */
            function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
            function ea(s) { return String(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

            /* ── Bootstrap ──────────────────────────────────────────── */
            window.initMap = initMap;
            applyTheme();
        })();
    </script>

    @if (!string.IsNullOrEmpty(mapsKey))







    {
        <text>
            <script src="https://maps.googleapis.com/maps/api/js?key=@mapsKey&callback=initMap&libraries=marker&loading=async" async defer></script>
        </text>
    }







    else







    {
        <script>
            document.getElementById('map-loading').innerHTML =
                '<div style="color:#ff4b4b;font-family:monospace;font-size:13px;text-align:center;padding:40px">' +
                '⚠ Google Maps API key missing.<br>' +
                '<small style="color:#606570">Add AppSettings:GoogleMapsApiKey to appsettings.json</small></div>';
        </script>
    }
    }